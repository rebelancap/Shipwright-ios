+s32 Player_VrAimHeld(Player* sohThis, s32 sohSite, Vec3f* sohPosOut, Vec3s* sohRotOut, MtxF* sohFrameOut) {
+    s32 sohModel = -1;
+    s32 sohTrimRow;
+    s32 sohVrHand = -1;
+    s32 sohSwordHandVr;
+    s32 sohCfg = (gSohVRLeftHanded != 0) ? 1 : 0;
+    s32 sohF;
+    f32 sohAx, sohAy, sohAz;
+    f32 sohDx, sohDy, sohDz, sohLen, sohFlat;
+    s16 sohYaw, sohPitch;
+    volatile float* sohB;
+    s32 sohRay;
+    f32 sohOx, sohOy, sohOz;
+
+    if ((gSohVRMode == 0) || (gSohVRAim == 0) || (gSohVRMotionHands == 0)) {
+        return 0;
+    }
+    sohSwordHandVr = (gSohVRLeftHanded != 0) ? 0 : 1;
