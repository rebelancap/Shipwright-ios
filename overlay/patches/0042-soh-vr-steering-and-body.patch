+/* SOH_IOS: Link's body in first person (donor
+ * Player_OverrideLimbDrawGameplayVRFirstPerson, z_player_lib.c:1514-1611).
+ * See the patch header, part B -- in particular why the two hand limbs
+ * survive gSohVRHideBody in R3 and what R4 does to them. */
+/* SOH_IOS (0042 rev3): the mirrored hand's culling flip is cleared on the
+ * NEXT limb, not inline, so the hand mesh AND the held item that draws on
+ * the same matrix in PostLimbDraw are both covered by it (donor
+ * sVrHandInvertCulling, z_player_lib.c:1516). */
+static s32 sSohVrHandInvertCulling = 0;
+
+/* rev15 (VR R14): PUBLISH BOTH AIM BASES, ONCE, BEFORE ANY HAND IS DRAWN.
+ *
+ * rev14 published each hand's basis from inside that hand's own
+ * OverrideLimbDraw and cleared both at limb 1. That is a draw-ORDER bug and
+ * it made the whole mechanism dead for the one item it was written for.
+ * PLAYER_LIMB_L_HAND is 0x10 and PLAYER_LIMB_R_HAND is 0x13; SkelAnime
+ * walks the limbs in index order; and the nocked arrow/slingshot seed is
+ * positioned from the L_HAND branch of Player_PostLimbDrawGameplay while
+ * the bow itself is in the R_HAND. So post(L_HAND) ran three limbs BEFORE
+ * override(R_HAND) published the basis it needed, gSohVRAimValid[off hand]
+ * was zero at that site on every frame in BOTH configurations, and
+ * Player_VrAimHeld fell straight back to vanilla. the user: "I see no
+ * change." He was reading the code correctly.
+ *
+ * The composition owes NOTHING to the limb walk -- the pin REPLACES the
+ * limb matrix with gSohVRHandMat rather than composing onto it -- so doing
+ * it once at limb 1 is not an approximation of the old site, it is the same
+ * arithmetic run somewhere the order cannot break it. */
+static void Player_VrPublishAimBases(Player* sohThis) {
+    s32 sohSwordHandVr = (gSohVRLeftHanded != 0) ? 0 : 1;
+    s32 sohAimCfg = (gSohVRLeftHanded != 0) ? 1 : 0;
+    s32 sohSlot = gSohVRPairSlot;
+    s32 sohLimb;
+
+    gSohVRAimValid[0] = gSohVRAimValid[1] = 0;
+    if ((gSohVRMode == 0) || (gSohVRMotionHands == 0)) {
+        return;
+    }
+    if ((sohSlot < 0) || (sohSlot > 1)) {
+        sohSlot = 0;
+    }
+    for (sohLimb = 0; sohLimb < 2; sohLimb++) {
+        /* sohLimb 0 = Link's L_HAND (his sword hand), 1 = his R_HAND. */
+        s32 sohVrHand = (sohLimb == 0) ? sohSwordHandVr : (sohSwordHandVr ^ 1);
+        s32 sohAimModel = (sohLimb == 0) ? sohThis->leftHandType : sohThis->rightHandType;
+        MtxF sohHandMtx;
+        MtxF sohAimMtx;
+        s32 sohI;
+        s32 sohJ;
+        s32 sohF;
+
+        /* A hand that is not tracked this frame has NO basis. A stale one
+         * would keep firing along wherever the controller was when tracking
+         * was last good, which is worse than falling back to vanilla. */
+        if (gSohVRHandValid[sohVrHand] == 0) {
+            continue;
+        }
+        for (sohI = 0; sohI < 4; sohI++) {
+            for (sohJ = 0; sohJ < 4; sohJ++) {
+                sohHandMtx.mf[sohI][sohJ] = gSohVRHandMat[sohSlot][sohVrHand][(sohI * 4) + sohJ];
+            }
+        }
+        Matrix_Push();
+        Matrix_Put(&sohHandMtx);
+        for (sohF = 0; sohF < SOHVR_AIMFRAME_N; sohF++) {
+            if ((sohF == 1) && (gSohVRItemCal != 0) && (sohAimModel >= 0) &&
+                (sohAimModel < SOHVR_ITEMCAL_N)) {
+                Matrix_RotateZYX((s16)(gSohVRItemRotDeg[sohAimModel][sohAimCfg][1] * 182.04f),
+                                 (s16)(gSohVRItemRotDeg[sohAimModel][sohAimCfg][0] * 182.04f),
+                                 (s16)(gSohVRItemRotDeg[sohAimModel][sohAimCfg][2] * 182.04f), MTXMODE_APPLY);
+            }
+            Matrix_Get(&sohAimMtx);
+            gSohVRAimBasis[sohVrHand][sohF][0] = sohAimMtx.xx;
+            gSohVRAimBasis[sohVrHand][sohF][1] = sohAimMtx.yx;
+            gSohVRAimBasis[sohVrHand][sohF][2] = sohAimMtx.zx;
+            gSohVRAimBasis[sohVrHand][sohF][3] = sohAimMtx.xy;
+            gSohVRAimBasis[sohVrHand][sohF][4] = sohAimMtx.yy;
+            gSohVRAimBasis[sohVrHand][sohF][5] = sohAimMtx.zy;
+            gSohVRAimBasis[sohVrHand][sohF][6] = sohAimMtx.xz;
+            gSohVRAimBasis[sohVrHand][sohF][7] = sohAimMtx.yz;
+            gSohVRAimBasis[sohVrHand][sohF][8] = sohAimMtx.zz;
+        }
+        gSohVRAimOrigin[sohVrHand][0] = sohAimMtx.xw;
+        gSohVRAimOrigin[sohVrHand][1] = sohAimMtx.yw;
+        gSohVRAimOrigin[sohVrHand][2] = sohAimMtx.zw;
+        Matrix_Pop();
+        gSohVRAimValid[sohVrHand] = 1;
+    }
+}
