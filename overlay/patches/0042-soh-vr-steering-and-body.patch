+/* SOH_IOS (overlay 0042 rev8, VR R9 part B): THE VR SHIELD STANCE.
+ *
+ * the user, on 1.0.1.12: "The left grip shield crouch lowers your height but
+ * now you can move around, which you're not supposed to."
+ *
+ * He is right and the cause is a gap between two overlays that are each
+ * correct. Vanilla stops a shielding Link inside Player_Action_80843188,
+ * which calls Player_DecelerateToZero every tick -- and overlay 0049
+ * suppresses Player_ActionHandler_11 for the physical shield, so that action
+ * is never entered (deliberately: it sets the itemAction = -1
+ * diverged-models marker outside the lifecycle that repairs it, which is the
+ * bug 0049 exists to avoid). Nothing else stops him, and rev2's kinematic
+ * override then writes the stick straight onto linearVelocity every tick.
+ *
+ * So the stance gets its own predicate, and it is the SAME two halves the
+ * crouch flag already used: vanilla's own flag, OR R held with a shield 0049
+ * says is on the arm. One definition, two consumers, so the eye that drops
+ * and the feet that stop can never disagree. */
+static s32 Player_VrShieldStance(Player* sohThis) {
+    if (sohThis == NULL) {
+        return 0;
+    }
+    /* VR FIRST PERSON ONLY. Every consumer below is a VR behaviour, and
+     * vanilla already stops a shielding Link its own way in the flat window
+     * and on iPhone -- where Player_ActionHandler_11 is not suppressed. */
+    if ((gSohVRMode == 0) || (gSohVRFpActive == 0)) {
+        return 0;
+    }
+    /* Harness override (`vr shieldstance 0|1|auto`), -1 = follow the game.
+     * The STANCE depends on owning a shield, having it on the arm and
+     * standing somewhere it can be raised -- none of which a simulator can
+     * promise -- while the two things this round fixes (he stops walking,
+     * and only then) are properties of the code either way. */
+    if (gSohVRShieldStanceForce >= 0) {
+        return (gSohVRShieldStanceForce != 0);
+    }
+    if (sohThis->stateFlags1 & PLAYER_STATE1_SHIELDING) {
+        return 1;
+    }
+    if ((sControlInput != NULL) && CHECK_BTN_ALL(sControlInput->cur.button, BTN_R) &&
+        Player_VrShieldHeld(sohThis)) {
+        return 1;
+    }
+    return 0;
+}
