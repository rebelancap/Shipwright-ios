+    if ((sohThis == NULL) || (gSohVRFpActive == 0) || (gSohVRMotionHands == 0)) {
+        return 0;
+    }
+    if (!Player_VrTriggerItem(sohThis->heldItemAction)) {
+        return 0;
+    }
+    gSohVREquipNoUse = gSohVREquipNoUse + 1;
+    return 1;
+}
