+    if (sohThis->heldItemAction == PLAYER_IA_HAMMER) {
+        sohItemSfx = NA_SE_IT_HAMMER_SWING;
+    } else if ((sohThis->heldItemAction == PLAYER_IA_SWORD_BIGGORON) && (gSaveContext.swordHealth > 0.0f)) {
+        sohItemSfx = NA_SE_IT_HAMMER_SWING;
+    } else {
+        sohItemSfx = sohHard ? NA_SE_IT_SWORD_SWING_HARD : NA_SE_IT_SWORD_SWING;
+    }
+    sohVoiceSfx = sohHard ? NA_SE_VO_LI_SWORD_L : NA_SE_VO_LI_SWORD_N;
+
+    if (sohItemSfx != 0) {
+        func_808328EC(sohThis, sohItemSfx);
+    }
+    Player_PlayVoiceSfx(sohThis, sohVoiceSfx);
+
+    if ((sohThis->heldItemAction >= PLAYER_IA_SWORD_MASTER) &&
+        (sohThis->heldItemAction <= PLAYER_IA_SWORD_BIGGORON)) {
+        gSaveContext.ship.stats.count[COUNT_SWORD_SWINGS]++;
+    }
+}
