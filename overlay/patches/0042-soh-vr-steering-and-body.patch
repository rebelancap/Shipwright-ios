+static s32 Player_OverrideLimbDrawGameplayVRFirstPerson(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos,
+                                                        Vec3s* rot, void* thisx) {
+    Player* sohThis = (Player*)thisx;
+    s32 sohRet = Player_OverrideLimbDrawGameplayDefault(play, limbIndex, dList, pos, rot, thisx);
+    s32 sohIsHand;
+    s32 sohMotion;
+    s32 sohSwordHandVr;
+    s32 sohVrHand;
+
+    /* rev4 (VR R5, overlay 0050): clear the hand-matrix TAG on the NEXT
+     * limb. The span it must cover is [this limb's own Mtx .. this limb's
+     * PostLimbDraw item Mtx], and SkelAnime_DrawFlexLimbOpa's order is
+     * override -> MATRIX_TOMTX -> postLimbDraw -> the child limb's override,
+     * so clearing HERE is exactly that span and nothing more. Same shape,
+     * and the same reason, as the culling flip below. */
+    gSohVRHandMtxTag = 0;
+
+    if (sSohVrHandInvertCulling) {
+        OPEN_DISPS(play->state.gfxCtx);
+        gSPClearExtraGeometryMode(POLY_OPA_DISP++, G_EX_INVERT_CULLING);
+        CLOSE_DISPS(play->state.gfxCtx);
+        sSohVrHandInvertCulling = 0;
+    }
+
+    /* rev4 (VR R5): the registration table is per FRAME, and limb 1 is the
+     * first override call of each draw. Resetting the COUNT is enough --
+     * stale pointers past it are never read. */
+    if (limbIndex == 1) {
+        gSohVRHandMtxCount[0] = gSohVRHandMtxCount[1] = 0;
+        gSohVRHandRecValid[0] = gSohVRHandRecValid[1] = 0;
+        /* rev13: and the published model types, so a hand that stops being
+         * pinned reports "nothing" rather than the last thing it held. */
+        gSohVRHeldModel[0] = gSohVRHeldModel[1] = -1;
+        /* rev15 (VR R14): BOTH bases, here, before any hand is drawn. See
+         * Player_VrPublishAimBases -- rev14 published them per hand inside
+         * the pin, and the bow's site runs three limbs earlier than the
+         * hand that holds it. */
+        Player_VrPublishAimBases(sohThis);
+    }
+
+    /* The camera sits inside Link's skull. Always. */
+    if ((limbIndex == PLAYER_LIMB_HEAD) || (limbIndex == PLAYER_LIMB_HAT)) {
+        *dList = NULL;
+        return sohRet;
+    }
+
+    sohIsHand = (limbIndex == PLAYER_LIMB_L_HAND) || (limbIndex == PLAYER_LIMB_R_HAND);
+    sohMotion = (gSohVRMotionHands != 0);
+    /* Link is LEFT-handed: his L_HAND holds the sword, his R_HAND the
+     * shield. The player's RIGHT controller drives the sword hand unless
+     * gSohVRLeftHanded. Each controller therefore drives Link's
+     * OPPOSITE-side hand model, which is why the mesh is mirrored below. */
+    sohSwordHandVr = (gSohVRLeftHanded != 0) ? 0 : 1;
+    sohVrHand = (limbIndex == PLAYER_LIMB_L_HAND) ? sohSwordHandVr : (sohSwordHandVr ^ 1);
+
+    if (gSohVRHideBody != 0) {
+        if (!sohIsHand) {
+            *dList = NULL;
+            return sohRet;
+        }
+    } else if (sohMotion) {
+        /* A floating hand on the end of an arm that is not there is worse
+         * than no arm at all (donor z_player_lib.c:1550-1556). */
+        if ((limbIndex == PLAYER_LIMB_L_SHOULDER) || (limbIndex == PLAYER_LIMB_L_FOREARM) ||
+            (limbIndex == PLAYER_LIMB_R_SHOULDER) || (limbIndex == PLAYER_LIMB_R_FOREARM)) {
+            *dList = NULL;
+            return sohRet;
+        }
+    }
+
+    /* THE PIN. gSohVRHandValid is the ONLY test: no Sense pair, tracking
+     * lost, or a hand out of view and this falls back to R3's ANIMATED hand
+     * on the very next frame, with nothing else needing to know. */
+    if (sohIsHand && sohMotion && (gSohVRHandValid[sohVrHand] != 0)) {
+        gSohVRHandPins = gSohVRHandPins + 1;
+        MtxF sohHandMtx;
+        s32 sohSlot = gSohVRPairSlot; /* the slot latched for THIS frame's pair */
+        s32 sohMirror;
+        s32 sohI;
+        s32 sohJ;
+        f32 sohScale = sohThis->actor.scale.x;
+        if ((sohSlot < 0) || (sohSlot > 1)) {
+            sohSlot = 0;
+        }
+        for (sohI = 0; sohI < 4; sohI++) {
+            for (sohJ = 0; sohJ < 4; sohJ++) {
+                sohHandMtx.mf[sohI][sohJ] = gSohVRHandMat[sohSlot][sohVrHand][(sohI * 4) + sohJ];
+            }
+        }
+        /* Replace the limb matrix outright, then fold Link's model scale
+         * back in -- which is what makes child and adult both work without
+         * the shell knowing anything about Link (donor VR_SetHandScale). */
+        /* rev4 (VR R5, overlay 0050): publish the matrix we are ABOUT to
+         * install as this hand's RECORD pose, and tag the Mtx allocations
+         * that follow. The interpreter re-seats them onto the live pose of
+         * each compositor frame with D = inverse(record) * live, which is
+         * what turns 20 Hz interpolated hands into headset-rate ones. Note
+         * this is the matrix BEFORE the scale and the mirror: those are the
+         * local part L, and (L * record) * D == L * live is the identity the
+         * whole mechanism rests on. */
+        for (sohI = 0; sohI < 4; sohI++) {
+            for (sohJ = 0; sohJ < 4; sohJ++) {
+                gSohVRHandRecMat[sohVrHand][(sohI * 4) + sohJ] = sohHandMtx.mf[sohI][sohJ];
+            }
+        }
+        gSohVRHandRecValid[sohVrHand] = 1;
+        gSohVRHandMtxTag = sohVrHand + 1;
+
+        Matrix_Put(&sohHandMtx);
+        Matrix_Scale(sohScale, sohScale, sohScale, MTXMODE_APPLY);
+        /* Mirroring is PER HAND, not global: the reflection that flips a
+         * mesh's handedness also mirrors held items' face designs. The sword
+         * survives that; the shield's crest reads upside-down. */
+        sohMirror = (gSohVRLeftHanded == 0) &&
+                    (((limbIndex == PLAYER_LIMB_L_HAND) ? gSohVRHandMirrorSword : gSohVRHandMirrorShield) != 0);
+        if (sohMirror) {
+            Matrix_Scale(-1.0f, 1.0f, 1.0f, MTXMODE_APPLY);
+            /* A reflection reverses triangle winding, so the hand and its
+             * held item would render inside-out. Cleared on the next limb. */
+            OPEN_DISPS(play->state.gfxCtx);
+            gSPSetExtraGeometryMode(POLY_OPA_DISP++, G_EX_INVERT_CULLING);
+            CLOSE_DISPS(play->state.gfxCtx);
+            sSohVrHandInvertCulling = 1;
+        }
+        /* rev13 (VR R12 item 4): THE HELD ITEM'S OWN SEAT.
+         *
+         * the user, on 1.0.1.15: the slingshot is about 90 degrees off and
+         * aimed sideways, and the ocarina is held upright with its
+         * mouthpiece pointing away. Both are the same thing, and it is
+         * structural rather than a bad number: vanilla does not attach an
+         * item to a generic hand -- the hand AND the item are one display
+         * list, picked by leftHandType / rightHandType, and each was
+         * modelled with the fist in whatever pose that item wants. The pin
+         * above installs ONE calibration, dialled against the SWORD's fist,
+         * so every other mesh inherits the sword's seat and comes out
+         * turned by the difference between its authored fist and the
+         * sword's.
+         *
+         * The correction is therefore keyed by the MODEL TYPE, which is the
+         * thing that names the mesh -- and names the hand with it, because
+         * PLAYER_MODELTYPE_LH_* is Link's sword hand and _RH_* his off
+         * hand. The second key is the CONFIGURATION, because the mirror
+         * above is applied only in right-handed play and a reflection flips
+         * the sign of two of the three angles.
+         *
+         * It is applied to the LIMB because there is nothing else to apply
+         * it to, and that is the right outcome: the wearer's own hands are
+         * hidden and what he is looking at is the item. It goes AFTER the
+         * record matrix is published, so it is part of the local L in
+         * overlay 0050's (L * record) * D == L * live identity and the
+         * headset-rate re-seat keeps working untouched. */
+        {
+            s32 sohModel = (limbIndex == PLAYER_LIMB_L_HAND) ? sohThis->leftHandType : sohThis->rightHandType;
+            if ((sohModel >= 0) && (sohModel < SOHVR_ITEMCAL_N)) {
+                s32 sohCfg = (gSohVRLeftHanded != 0) ? 1 : 0;
+                gSohVRHeldModel[sohVrHand] = sohModel;
+                if (gSohVRItemCal != 0) {
+                    /* Rotate about the grip first, then offset along the
+                     * corrected item's own axes -- which is the order a
+                     * human dials in: get it pointing right, then slide it
+                     * into the fist. 182.04 is 0x10000/360, the binang the
+                     * whole file uses. */
+                    Matrix_RotateZYX((s16)(gSohVRItemRotDeg[sohModel][sohCfg][1] * 182.04f),
+                                     (s16)(gSohVRItemRotDeg[sohModel][sohCfg][0] * 182.04f),
+                                     (s16)(gSohVRItemRotDeg[sohModel][sohCfg][2] * 182.04f), MTXMODE_APPLY);
+                    Matrix_Translate(gSohVRItemOffU[sohModel][sohCfg][0], gSohVRItemOffU[sohModel][sohCfg][1],
+                                     gSohVRItemOffU[sohModel][sohCfg][2], MTXMODE_APPLY);
+                }
+            } else {
+                gSohVRHeldModel[sohVrHand] = -1;
+            }
+        }
+        /* The caller applies Matrix_TranslateRotateZYX(pos, rot) next; zero
+         * both so the base skeleton contributes nothing on top of the pose
+         * we just installed (z_skelanime.c:406-407). */
+        pos->x = pos->y = pos->z = 0.0f;
+        rot->x = rot->y = rot->z = 0;
+    }
+
+    return sohRet;
+}
