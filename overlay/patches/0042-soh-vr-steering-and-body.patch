+/* SOH_IOS (overlay 0042 rev19, VR R18 items 1, 2 and 3): IS THE ITEM IN
+ * HAND ONE THE VR TRIGGER DRIVES?
+ *
+ * the user, wearing 1.0.1.22: "while holding an item, either trigger performs
+ * the action -- it's counterintuitive to use the RIGHT trigger when the
+ * slingshot is in the LEFT hand"; and "the boomerang throws itself as soon
+ * as you select it"; and the hammer does nothing on either trigger. All
+ * three answers need the same question asked once: is the thing in hand an
+ * item whose ACTION is a trigger pull?
+ *
+ * IT IS NOT gSohVRItemTriggerMask != 0. That mask is every non-sword C
+ * item -- a bottle, a mask, the ocarina, a bomb -- because the mask's job
+ * is "which button does the held item live on", which is a different
+ * question and a broader one. Widening the both-triggers rule to it would
+ * take Z and B away from a Link holding a bottle, and take the ocarina's
+ * own note bindings off the sword trigger.
+ *
+ * THE LIST, and why each member is on it:
+ *   BOW .. BOW_0E, SLINGSHOT, HOOKSHOT, LONGSHOT -- hold to aim, release
+ *     to loose. The trigger IS the draw.
+ *   BOOMERANG -- a pull throws it (rev17's direct throw).
+ *   HAMMER, DEKU_STICK -- their swing is a press of the item's own button
+ *     (func_8083BB20 reads sUseHeldItem; its BTN_B branch is gated on
+ *     actor.category != ACTORCAT_PLAYER and so never runs for the player),
+ *     and neither is covered by the physical blade (overlay 0048 covers
+ *     melee weapons 1..3, the three swords). Without the trigger they have
+ *     no attack at all in VR, which is exactly what the user reported.
+ *
+ * DELIBERATELY NOT ON IT: bombs and bombchus (their C press pulls one out
+ * and A/B throws it -- taking those away would leave a lit bomb in the
+ * hand), deku nuts, the ocarina, bottles, masks, the magic spells and the
+ * lens. They keep the classic profile: the sword-hand trigger mirrors the
+ * item, the off-hand trigger stays Z. */
+static s32 Player_VrTriggerItem(s32 sohAction) {
+    if ((sohAction >= PLAYER_IA_BOW) && (sohAction <= PLAYER_IA_BOW_0E)) {
+        return 1;
+    }
+    switch (sohAction) {
+        case PLAYER_IA_SLINGSHOT:
+        case PLAYER_IA_HOOKSHOT:
+        case PLAYER_IA_LONGSHOT:
+        case PLAYER_IA_BOOMERANG:
+        case PLAYER_IA_HAMMER:
+        case PLAYER_IA_DEKU_STICK:
+            return 1;
+        default:
+            return 0;
+    }
+}
