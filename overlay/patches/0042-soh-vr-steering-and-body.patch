+/* SOH_IOS: the four-case steering table. See the patch header, part A. */
+static s16 Player_GetSteeringYaw(PlayState* play, Player* sohThis) {
+    if ((gSohVRFpActive == 0) || (gSohVRHeadingValid == 0) || (sohThis == NULL)) {
+        return Camera_GetInputDirYaw(GET_ACTIVE_CAM(play)); /* case 1 */
+    }
+    if (sohThis->stateFlags2 & (PLAYER_STATE2_CRAWLING | PLAYER_STATE2_GRABBING_DYNAPOLY)) {
+        return sohThis->actor.shape.rot.y; /* case 2 */
+    }
+    if (sSohVRZTargetActive) {
+        /* rev5 (VR R7 verdict 5): case 3 fires on vanilla lock-on itself.
+         * rev6 (VR R8 item 9) removed the comfort-framing half of this
+         * test with the option; what is left is the one that matters and
+         * is the STRAFE. This is the
+         * STRAFE: read in the body frame, forward closes on the target and
+         * left/right circle it, exactly as flat play. */
+        return sohThis->actor.shape.rot.y; /* case 3 */
+    }
+    return (s16)gSohVRHeadingYaw; /* case 4 */
+}
