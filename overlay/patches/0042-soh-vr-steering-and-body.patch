+static s32 Player_VrAttackCombo(s32 sohMode) {
+    static s32 sohComboN = 0;
+    static s32 sohChainTicks = 0;
+
+    if (sohMode < 0) {
+        sohComboN = 0;
+        sohChainTicks = 0;
+        return 0;
+    }
+    if (sohMode == 0) {
+        if (sohChainTicks > 0) {
+            sohChainTicks = sohChainTicks - 1;
+        }
+        return 0;
+    }
+    if ((sohChainTicks == 0) || (sohComboN >= 3)) {
+        sohComboN = 0;
+    }
+    sohComboN = sohComboN + 1;
+    sohChainTicks = 7;
+    return (sohComboN >= 3);
+}
