+
+static f32 SohVrDot(Vec3f* a, Vec3f* b) {
+    return (a->x * b->x) + (a->y * b->y) + (a->z * b->z);
+}
+
+static void SohVrSub(Vec3f* out, Vec3f* a, Vec3f* b) {
+    out->x = a->x - b->x;
+    out->y = a->y - b->y;
+    out->z = a->z - b->z;
+}
+
+static f32 SohVrLen(Vec3f* a) {
+    return sqrtf(SohVrDot(a, a));
+}
+
+/* Closest point on segment ab to p. */
+static void SohVrClosestOnSeg(Vec3f* out, Vec3f* p, Vec3f* a, Vec3f* b) {
+    Vec3f ab;
+    Vec3f ap;
+    f32 d;
+    f32 t;
+
+    SohVrSub(&ab, b, a);
+    SohVrSub(&ap, p, a);
+    d = SohVrDot(&ab, &ab);
+    if (d < 1e-9f) {
+        *out = *a;
+        return;
+    }
+    t = SohVrDot(&ap, &ab) / d;
+    if (t < 0.0f) {
+        t = 0.0f;
+    } else if (t > 1.0f) {
+        t = 1.0f;
+    }
+    out->x = a->x + (ab.x * t);
+    out->y = a->y + (ab.y * t);
+    out->z = a->z + (ab.z * t);
+}
+
+/* TRUE segment-to-triangle distance squared, sampled along the segment, plus
+ * the signed distance of the blade's FRONT-MOST endpoint. Donor :480-497 --
+ * and its comment is the reason this is not a centroid test: with centroids,
+ * a big wall triangle the blade is resting ON loses to a small irrelevant one
+ * and the harvested set churns every tick. */
+static f32 SohVrSegTriDist2(Vec3f* base, Vec3f* tip, Vec3f* p0, Vec3f* p1, Vec3f* p2, Vec3f* nrm, f32* outFront) {
+    f32 best = 1e30f;
+    f32 d0;
+    f32 d1;
+    Vec3f rel;
+    s32 i;
+
+    SohVrSub(&rel, base, p0);
+    d0 = SohVrDot(&rel, nrm);
+    SohVrSub(&rel, tip, p0);
+    d1 = SohVrDot(&rel, nrm);
+    *outFront = (d0 > d1) ? d0 : d1;
+
+    for (i = 0; i <= 4; i++) {
+        f32 t = (f32)i * 0.25f;
+        Vec3f p;
+        Vec3f q;
+        Vec3f d;
+        Vec3f qa;
+        Vec3f qb;
+        Vec3f qc;
+        f32 m;
+        f32 sd;
+
+        p.x = base->x + ((tip->x - base->x) * t);
+        p.y = base->y + ((tip->y - base->y) * t);
+        p.z = base->z + ((tip->z - base->z) * t);
+        SohVrSub(&rel, &p, p0);
+        sd = SohVrDot(&rel, nrm);
+        q.x = p.x - (nrm->x * sd);
+        q.y = p.y - (nrm->y * sd);
+        q.z = p.z - (nrm->z * sd);
+        /* Cheap and sufficient: distance to the nearest of the three edges and
+         * to the in-plane projection. The solver does the exact work; this is
+         * only a RANKING. */
+        SohVrClosestOnSeg(&qa, &q, p0, p1);
+        SohVrClosestOnSeg(&qb, &q, p1, p2);
+        SohVrClosestOnSeg(&qc, &q, p2, p0);
+        SohVrSub(&d, &p, &qa);
+        m = SohVrDot(&d, &d);
+        SohVrSub(&d, &p, &qb);
+        if (SohVrDot(&d, &d) < m) {
+            m = SohVrDot(&d, &d);
+        }
+        SohVrSub(&d, &p, &qc);
+        if (SohVrDot(&d, &d) < m) {
+            m = SohVrDot(&d, &d);
+        }
+        if ((sd * sd) < m) {
+            m = sd * sd;
+        }
+        if (m < best) {
+            best = m;
+        }
+    }
+    return best;
+}
+
+static s32 SohVrSwordHand(void) {
+    return (gSohVRLeftHanded != 0) ? 0 : 1;
+}
