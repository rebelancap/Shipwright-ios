+/* Sticky poly set: a poly that already constrains the blade keeps a rank
+ * bonus, so the harvested set does not churn while the blade rests on a wall.
+ * Donor :606-612 and :655-658 -- one of three co-required tricks; without it
+ * a member blinking out for one step lets the sim sink and the snap back IS
+ * the jitter. */
+static CollisionPoly* sSohVrSticky[SOH_VR_MAX_LEVEL_TRIS];
+static s32 sSohVrStickyCount = 0;
