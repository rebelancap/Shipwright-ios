+/* Read the blade line the shell published for THIS frame's pair. Returns 0 if
+ * there is nothing coherent to read, which is the same test the hand pin uses
+ * and for the same reason. */
+static s32 SohVrBlade_Line(Vec3f* base, Vec3f* tip, Vec3f* prevBase, Vec3f* prevTip) {
+    s32 slot = gSohVRPairSlot;
+    s32 hand = SohVrSwordHand();
+    const volatile f32* v;
+
+    if ((slot < 0) || (slot > 1)) {
+        slot = 0;
+    }
+    if (gSohVRBladeValid[hand] == 0) {
+        return 0;
+    }
+    v = gSohVRBladeLine[slot][hand];
+    base->x = v[0];
+    base->y = v[1];
+    base->z = v[2];
+    tip->x = v[3];
+    tip->y = v[4];
+    tip->z = v[5];
+    prevBase->x = v[6];
+    prevBase->y = v[7];
+    prevBase->z = v[8];
+    prevTip->x = v[9];
+    prevTip->y = v[10];
+    prevTip->z = v[11];
+    return 1;
+}
