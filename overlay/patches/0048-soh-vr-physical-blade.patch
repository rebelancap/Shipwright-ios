+s32 SohVrBlade_Active(PlayState* play, Player* this) {
+    s32 hand;
+
+    if ((play == NULL) || (this == NULL)) {
+        return 0;
+    }
+    if ((gSohVRMode == 0) || (gSohVRFpActive == 0) || (gSohVRMotionHands == 0)) {
+        return 0;
+    }
+    if (gSohVRBladeDamage == 0) {
+        return 0; /* the user chose R4's authored attack */
+    }
+    if (this->actor.category != ACTORCAT_PLAYER) {
+        return 0;
+    }
+    hand = SohVrSwordHand();
+    if (gSohVRHandValid[hand] == 0) {
+        return 0; /* no pair, or tracking lost: 0042's fallback owns the frame */
+    }
+    return 1;
+}
