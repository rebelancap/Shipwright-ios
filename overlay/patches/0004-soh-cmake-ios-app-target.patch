 # Target
 ################################################################################
 add_executable(${PROJECT_NAME} ${ALL_FILES})
+
+if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # LUS defines __IOS__ only PRIVATE to itself; soh TUs (and LUS headers
+    # they include) need it too.
+    target_compile_definitions(${PROJECT_NAME} PRIVATE __IOS__)
+    # iOS app shell (touch controls, orientation) lives in the Shipwright-ios
+    # repo, passed as SOH_IOS_SHELL_DIR.
+    if(NOT EXISTS "${SOH_IOS_SHELL_DIR}/SohIosShell.m")
+        message(FATAL_ERROR "iOS build requires -DSOH_IOS_SHELL_DIR=<dir with SohIosShell.m>")
+    endif()
+    target_sources(${PROJECT_NAME} PRIVATE "${SOH_IOS_SHELL_DIR}/SohIosShell.m")
+    target_include_directories(${PROJECT_NAME} PRIVATE "${SOH_IOS_SHELL_DIR}")
+    # Remote console bridge (D-040): an UNAUTHENTICATED TCP command server that
+    # injects input, writes CVars and reads crash.txt/logs — and soh://console
+    # can switch it on from any tapped link. It is compiled OUT unless asked
+    # for, so public/release builds cannot expose it at all. Dev (simulator)
+    # and the maintainer's own OTA builds opt in with -DSOH_REMOTE_CONSOLE=ON.
+    option(SOH_REMOTE_CONSOLE "Compile in the remote console bridge (dev/OTA builds only)" OFF)
+    if(SOH_REMOTE_CONSOLE)
+        target_compile_definitions(${PROJECT_NAME} PRIVATE SOH_REMOTE_CONSOLE=1)
+        message(STATUS "soh: REMOTE CONSOLE COMPILED IN — do not publish this build")
+    else()
+        message(STATUS "soh: remote console compiled out (public-safe)")
+    endif()
+    # UTType (document-picker ROM onboarding) + GCController (physical
+    # controller detection) used by the shell.
+    target_link_libraries(${PROJECT_NAME} PRIVATE "-framework UniformTypeIdentifiers"
+                                                  "-framework GameController")
+    # App icon asset catalog (compiled by actool via the Xcode generator).
+    target_sources(${PROJECT_NAME} PRIVATE "${SOH_IOS_SHELL_DIR}/Assets.xcassets")
+    set_source_files_properties("${SOH_IOS_SHELL_DIR}/Assets.xcassets" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
+    # soh's main() becomes SDL_main. On iPhone, SDL2main's UIKit shim provides
+    # the real main() -> UIApplicationMain -> SDL_main on the main thread. On
+    # visionOS (D-030) the Swift @main App is the entry instead (SDL2main is
+    # NOT linked); SohHostViewController calls SDL_main once the scene is live.
+    set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/src/code/main.c PROPERTIES COMPILE_DEFINITIONS "main=SDL_main")
+    if(SOH_VISIONOS)
+        # SwiftUI app entry (D-030) in its OWN static lib: the Xcode generator
+        # ignores COMPILE_LANGUAGE genexes when composing OTHER_SWIFT_FLAGS, so
+        # any .swift source on the soh target inherits its C warning flags and
+        # swiftc hard-errors. A separate flag-clean target sidesteps the whole
+        # class. Swift's @main emits main; the linker extracts it from the
+        # archive exactly like SDL2main's (which is NOT linked on visionOS).
+        enable_language(Swift)
+        add_library(sohvisionswift STATIC "${SOH_IOS_SHELL_DIR}/SohVisionApp.swift")
+        set_target_properties(sohvisionswift PROPERTIES
+            XCODE_ATTRIBUTE_SWIFT_VERSION "5.0"
+            XCODE_ATTRIBUTE_SWIFT_OBJC_BRIDGING_HEADER "${SOH_IOS_SHELL_DIR}/SohVision-Bridging-Header.h")
+        target_sources(${PROJECT_NAME} PRIVATE
+            "${SOH_IOS_SHELL_DIR}/SohHostViewController.m"
+            "${SOH_IOS_SHELL_DIR}/SohImmersive.m")
+        # -all_load on the archive: main lives there and nothing else
+        # references the Swift objects. SDK swift dir: the app target has no
+        # Swift sources, so Xcode won't add runtime search paths itself.
+        target_link_libraries(${PROJECT_NAME} PRIVATE
+            "-Wl,-force_load,$<TARGET_FILE:sohvisionswift>"
+            "-L$(SDKROOT)/usr/lib/swift"
+            "-framework CompositorServices" "-framework ARKit" "-framework AVFAudio")
+        add_dependencies(${PROJECT_NAME} sohvisionswift)
+    endif()
+    # soh.o2r is a ROM-independent build artifact that must be produced by a
+    # HOST build (GenerateSohOtr) and is bundled as a resource.
+    set(SOH_O2R_PATH "" CACHE FILEPATH "Path to a host-built soh.o2r to bundle")
+    if(NOT EXISTS "${SOH_O2R_PATH}")
+        message(FATAL_ERROR "iOS build requires -DSOH_O2R_PATH=<host-built soh.o2r>")
+    endif()
+    target_sources(${PROJECT_NAME} PRIVATE "${SOH_O2R_PATH}" "${CMAKE_BINARY_DIR}/gamecontrollerdb.txt")
+    set_source_files_properties("${SOH_O2R_PATH}" "${CMAKE_BINARY_DIR}/gamecontrollerdb.txt"
+        PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
+endif()
 
 if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
 use_props(${PROJECT_NAME} "${CMAKE_CONFIGURATION_TYPES}" "${DEFAULT_CXX_PROPS}")
