+/* The parametric trapezoid, in R_HAND MODEL space (game units x100 -- the
+ * same space vanilla's quadSrc lives in). Donor
+ * VrCombat_ShieldQuadModelVerts, VrShield.cpp:107-150. */
+void Player_VrShieldQuadVerts(Vec3f* out) {
+    f32 halfWTop = gSohVRShieldQuad[0] * 50.0f;
+    f32 halfWBot = gSohVRShieldQuad[1] * 50.0f;
+    f32 halfH = gSohVRShieldQuad[2] * 50.0f;
+    f32 cx = gSohVRShieldQuad[3] * 100.0f;
+    f32 cy = gSohVRShieldQuad[4] * 100.0f;
+    f32 cz = gSohVRShieldQuad[5] * 100.0f;
+    f32 d2r = 3.14159265f / 180.0f;
+    f32 pitch = gSohVRShieldQuad[6] * d2r;
+    f32 yaw = gSohVRShieldQuad[7] * d2r;
+    f32 roll = gSohVRShieldQuad[8] * d2r;
+    f32 cp = cosf(pitch);
+    f32 sp = sinf(pitch);
+    f32 cyw = cosf(yaw);
+    f32 syw = sinf(yaw);
+    f32 cr = cosf(roll);
+    f32 sr = sinf(roll);
+    /* R = Rz(roll) * Ry(yaw) * Rx(pitch); axW is width, axH height, axN the
+     * outward normal. */
+    f32 axW[3];
+    f32 axH[3];
+    f32 axN[3];
+    f32 c3[3];
+    s32 axis;
+
+    axW[0] = cr * cyw;
+    axW[1] = sr * cyw;
+    axW[2] = -syw;
+    axH[0] = (cr * syw * sp) - (sr * cp);
+    axH[1] = (sr * syw * sp) + (cr * cp);
+    axH[2] = cyw * sp;
+    axN[0] = (cr * syw * cp) + (sr * sp);
+    axN[1] = (sr * syw * cp) - (cr * sp);
+    axN[2] = cyw * cp;
+    /* THE SHIFTS LIVE IN THE COLLIDER'S OWN TILTED FRAME -- across along its
+     * width axis, up along its height axis, out along its normal -- so they
+     * keep meaning what their names say at any tilt. Shifting in raw hand
+     * axes made up/down slide sideways, and no rotation could fix it because
+     * the offsets did not rotate with the quad. */
+    for (axis = 0; axis < 3; axis++) {
+        c3[axis] = (axW[axis] * cx) + (axH[axis] * cy) + (axN[axis] * cz);
     }
+    /* Vanilla's zigzag vertex order, which Collider_SetQuadVertices expects:
+     * 0 bottom-left, 1 bottom-right, 2 top-left, 3 top-right. */
+    for (axis = 0; axis < 3; axis++) {
+        f32* v0 = (axis == 0) ? &out[0].x : ((axis == 1) ? &out[0].y : &out[0].z);
+        f32* v1 = (axis == 0) ? &out[1].x : ((axis == 1) ? &out[1].y : &out[1].z);
+        f32* v2 = (axis == 0) ? &out[2].x : ((axis == 1) ? &out[2].y : &out[2].z);
+        f32* v3 = (axis == 0) ? &out[3].x : ((axis == 1) ? &out[3].y : &out[3].z);
+
+        *v0 = c3[axis] - (axW[axis] * halfWBot) - (axH[axis] * halfH);
+        *v1 = c3[axis] + (axW[axis] * halfWBot) - (axH[axis] * halfH);
+        *v2 = c3[axis] - (axW[axis] * halfWTop) + (axH[axis] * halfH);
+        *v3 = c3[axis] + (axW[axis] * halfWTop) + (axH[axis] * halfH);
+    }
 }
+#endif
 
