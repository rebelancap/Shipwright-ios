+        case PLAYER_MODELTYPE_LH_SWORD:
+        case PLAYER_MODELTYPE_LH_SWORD_2:
+        case PLAYER_MODELTYPE_LH_BGS:
+        case PLAYER_MODELTYPE_LH_HAMMER:
+            break;
+        case PLAYER_MODELTYPE_LH_CLOSED:
+            /* The Deku stick has no hand model of its own -- it renders over
+             * a closed fist -- so the fist PLUS the stick logically held is
+             * its "visibly in hand". */
+            if (this->heldItemAction != PLAYER_IA_DEKU_STICK) {
+                return 0;
+            }
+            break;
+        default:
+            return 0;
+    }
+    /* Hands-off states: both arms are doing something else. */
+    if (this->stateFlags1 &
+        (PLAYER_STATE1_CLIMBING_LADDER | PLAYER_STATE1_CLIMBING_LEDGE | PLAYER_STATE1_HANGING_OFF_LEDGE |
+         PLAYER_STATE1_IN_WATER | PLAYER_STATE1_ON_HORSE | PLAYER_STATE1_CARRYING_ACTOR | PLAYER_STATE1_DEAD)) {
+        return 0;
+    }
