+s32 Player_VrShieldHeld(Player* this) {
+    s32 sohShieldHand;
+
+    if ((gSohVRMode == 0) || (gSohVRFpActive == 0) || (gSohVRMotionHands == 0) ||
+        (gSohVRShieldPhysical == 0)) {
+        return 0;
+    }
+    if (this == NULL) {
+        return 0;
+    }
+    /* The shield hand is the opposite of the sword hand, and the sword hand
+     * is the player's RIGHT controller unless left-handed. */
+    sohShieldHand = ((gSohVRLeftHanded != 0) ? 0 : 1) ^ 1;
+    if (gSohVRHandValid[sohShieldHand] == 0) {
+        return 0; /* not tracked: vanilla stance blocking, unchanged */
+    }
+    if (this->actor.category != ACTORCAT_PLAYER) {
+        return 0;
+    }
+    if (this->currentShield == PLAYER_SHIELD_NONE) {
+        return 0;
+    }
+    if (Player_IsChildWithHylianShield(this)) {
+        return 0; /* child carries the Hylian shield on his back */
+    }
+    if (Player_HoldsTwoHandedWeapon(this) &&
+        !(CVarGetInteger(CVAR_CHEAT("ShieldTwoHanded"), 0) &&
+          (this->heldItemAction != PLAYER_IA_DEKU_STICK))) {
+        return 0;
+    }
