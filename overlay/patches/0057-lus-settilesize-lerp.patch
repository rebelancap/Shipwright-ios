+bool gfx_set_tile_size_lerp_handler_rdp(F3DGfx** cmd0) {
+    F3DGfx* cmd = *cmd0;
+    Interpreter* gfx = mInstance.lock().get();
+
+    int tile = C1(24, 3);
+    float coords[8];
+    for (int i = 0; i < 8; i += 2) {
+        ++(*cmd0);
+        memcpy(&coords[i], &(*cmd0)->words.w0, sizeof(float));
+        memcpy(&coords[i + 1], &(*cmd0)->words.w1, sizeof(float));
+    }
+
+    // SOH_IOS (overlay 0059): prefer the per-rendered-frame table the port filled
+    // for this tick; mInterpolationT remains the fallback and the default (1.0f =
+    // current tick), so a draw outside an interpolated tick is unchanged.
+    float t = gfx->mInterpolationIndex >= 0 && (size_t)gfx->mInterpolationIndex < gfx->mInterpolationTs.size()
+                  ? gfx->mInterpolationTs[gfx->mInterpolationIndex]
+                  : gfx->mInterpolationT;
+    gfx->mRdp->texture_tile[tile].uls = coords[0] + t * (coords[4] - coords[0]);
+    gfx->mRdp->texture_tile[tile].ult = coords[1] + t * (coords[5] - coords[1]);
+    gfx->mRdp->texture_tile[tile].lrs = coords[2] + t * (coords[6] - coords[2]);
+    gfx->mRdp->texture_tile[tile].lrt = coords[3] + t * (coords[7] - coords[3]);
+    gfx->mRdp->textures_changed[0] = true;
+    gfx->mRdp->textures_changed[1] = true;
 
     return false;
 }
