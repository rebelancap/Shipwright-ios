 }
 
+// SohTorch::Extract takes the ROM bytes in big-endian (.z64) order (#7301); the
+// game normalizes with BitConverter::RomToBigEndian, this tool by the first word.
+static bool ReadRomBigEndian(const std::string& path, std::vector<uint8_t>& out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    out.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+    if (out.size() < 4 || (out.size() % 4) != 0) {
+        return false;
+    }
+    if (out[0] == 0x37 && out[1] == 0x80) { // .v64: 16-bit byteswapped
+        for (size_t i = 0; i < out.size(); i += 2) {
+            std::swap(out[i], out[i + 1]);
+        }
+    } else if (out[0] == 0x40 && out[1] == 0x12) { // .n64: 32-bit little-endian
+        for (size_t i = 0; i < out.size(); i += 4) {
+            std::swap(out[i], out[i + 3]);
+            std::swap(out[i + 1], out[i + 2]);
+        }
+    }
+    return out[0] == 0x80 && out[1] == 0x37;
+}
