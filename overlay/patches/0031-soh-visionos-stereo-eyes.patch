+extern "C" {
+extern volatile int gSoh3DMode;
+extern void* volatile gSoh3DEyeTexture[2];
+extern volatile int gSoh3DEyeFrames[2];
+extern volatile int gSoh3DEyeW, gSoh3DEyeH;
+extern volatile float gSoh3DCamDist, gSoh3DCamP00;
+extern volatile float gSoh3DCamRight[3], gSoh3DCamFwd[3], gSoh3DCamEye[3];
+extern volatile float gSoh3DDbgConv, gSoh3DDbgSep;
+extern volatile int gSoh3DPaused;
+extern volatile int gSoh3DAiming;
+extern volatile int gSoh3DInPlay;
+extern volatile int gSoh3DDbg2DW, gSoh3DDbg2DH;
+extern volatile int gSoh3DDbgCurW, gSoh3DDbgCurH;
+}
+static int sSoh3DEye = 0;
+static float sSoh3DSep = 3.0f;
+static float sSoh3DConv = 300.0f;
+static float sSoh3DConvSmooth = 300.0f;
+static float sSoh3DPauseMix = 1.0f; // 1 = full stereo, 0 = flat (paused)
+static float sSoh3DAimMix = 0.0f;   // 1 = aiming (slingshot/bow/look)
+static int sSoh3DSkybox = 0;        // inside skybox draw (0033 sentinels)
+static float sSoh3DP[4][4];
+// Off-axis stereo for OoT's COMBINED viewing*projection matrix (rev4).
+// The camera axes cannot be derived from the combined matrix, so the game
+// exports its basis (0032 v2). Camera shift: world translation by
+// -e*right folded into the matrix. Convergence skew: clip_x += s*view_z
+// with view_z = dot(v,fwd) - dot(eye,fwd) and s = e*P00/C so parallax is
+// zero exactly at the focus distance. Perspective detect: the combined
+// matrix's w-column top-3 is (+/-)forward (unit) — ortho has (0,0,0).
+// (rev1-3 used world-X offsets + a w-column COMPONENT test: depth varied
+// with camera heading, vertical parallax broke fusion, and stereo cut
+// out entirely at some headings — all four device-round symptoms.)
+static void Soh3DStereoP(float out[4][4], const float in[4][4]) {
+    memcpy(out, in, sizeof(sSoh3DP));
+    float sohWx = in[0][3], sohWy = in[1][3], sohWz = in[2][3];
+    if (sohWx * sohWx + sohWy * sohWy + sohWz * sohWz < 0.25f) {
+        return; // orthographic (HUD/2D): stays on the panel plane
+    }
+    const float e = (sSoh3DEye == 2 ? 1.0f : -1.0f) * 0.5f * sSoh3DSep * sSoh3DPauseMix;
+    if (e == 0.0f) {
+        return;
+    }
+    // Skybox draws (0033 sentinels): the skybox is camera-centered, so the
+    // eye translation CANCELS for it — zero disparity = sky ON the panel,
+    // stereoscopically in FRONT of the terrain behind it (the disorienting
+    // clouds; same as sm64coopdx D-031). Skew-only lands it at infinity.
+    if (!sSoh3DSkybox) {
+        const float dx = -e * gSoh3DCamRight[0];
+        const float dy = -e * gSoh3DCamRight[1];
+        const float dz = -e * gSoh3DCamRight[2];
+        for (int j = 0; j < 4; j++) {
+            out[3][j] += dx * out[0][j] + dy * out[1][j] + dz * out[2][j];
+        }
+    }
+    const float s = e * gSoh3DCamP00 / sSoh3DConv;
+    const float sohEyeF = gSoh3DCamEye[0] * gSoh3DCamFwd[0] + gSoh3DCamEye[1] * gSoh3DCamFwd[1] +
+                          gSoh3DCamEye[2] * gSoh3DCamFwd[2];
+    out[0][0] += s * gSoh3DCamFwd[0];
+    out[1][0] += s * gSoh3DCamFwd[1];
+    out[2][0] += s * gSoh3DCamFwd[2];
+    out[3][0] += s * -sohEyeF;
+}
+#endif
