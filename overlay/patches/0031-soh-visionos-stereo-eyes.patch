 void GfxRenderingAPIMetal::FinishRender() {
+}
+
+// SOH_IOS (overlay 0031): end-of-eye-pass flush for stereoscopic 3D. The
+// screen framebuffer was never set up this frame (no drawable — a hidden
+// window's acquire stalls), so EndFrame's present path is unusable: commit
+// every drawn framebuffer's command buffer, ride 0019's pending-mip pass on
+// the last one, and replicate EndFrame's per-frame state cleanup.
+extern "C" {
+extern void* volatile gSoh3DEyeTexture[3];
+// rev13 (VR R1): the eye's DEPTH texture, published beside the colour
+// one so the VR blit can convert forward-Z -> reverse-Z (spec D2).
+extern void* volatile gSoh3DEyeDepthTexture[3];
+// rev14 (VR R2a, trap D35): the pair tag each published eye carries.
+extern volatile unsigned int gSoh3DEyeTag[3];
+}
+#ifndef __IOS__
+// rev13: WEAK zeroed defaults so desktop builds (the macOS build) link
+// without the iOS shell, which owns the strong definitions. Weak loses
+// to strong wherever the shell IS linked; here the publish path is
+// unreachable anyway (nothing ever sets an eye framebuffer).
+extern "C" {
+__attribute__((weak)) void* volatile gSoh3DEyeTexture[3] = { nullptr, nullptr, nullptr };
+__attribute__((weak)) void* volatile gSoh3DEyeDepthTexture[3] = { nullptr, nullptr, nullptr };
+__attribute__((weak)) volatile unsigned int gSoh3DEyeTag[3] = { 0u, 0u, 0u };
+}
+#endif
+static int sSoh3DPublishFb = -1;
+static int sSoh3DPublishEye = -1;
+static unsigned int sSoh3DPublishTag = 0;
+static std::mutex sSoh3DPublishMutex;
+static void* sSoh3DRetired[16];
+static int sSoh3DRetiredIdx = 0;
+// SOH_IOS (overlay 0031 rev17, VR R8 part C): orphaned pending-mip drains.
+// Non-zero means a walk uploaded textures and drew no framebuffer -- see
+// EndFrameOffscreen. Read back through SohIos_MipOrphans (overlay 0045).
+unsigned long long gSohIosMipOrphans = 0;
+
+// rev14 (trap D35): hand the compositor BOTH eyes in ONE critical
+// section. Reading gSoh3DEyeTexture[0] and [1] separately is precisely
+// the torn read the tag exists to detect -- the two eyes are published
+// by independent completion handlers and a read can land between them.
+// rev15 (VR R2b, spec D7): the HUD plane is published through the
+// SAME completion machinery, in slot 2, so it can never be sampled
+// mid-GPU either. It carries the pair tag of the host frame that built
+// it, which is what lets the compositor refuse a HUD from a different
+// frame than the eyes it is composited over.
+extern "C" void Soh3DHudSnapshot(void** sohTex, unsigned int* sohTag) {
+    std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+    if (sohTex != nullptr) {
+        sohTex[0] = (void*)gSoh3DEyeTexture[2];
+    }
+    if (sohTag != nullptr) {
+        sohTag[0] = gSoh3DEyeTag[2];
+    }
+}
+
+extern "C" void Soh3DEyePairSnapshot(void** sohTex, void** sohDepth, unsigned int* sohTag) {
+    std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+    for (int sohE = 0; sohE < 2; sohE++) {
+        if (sohTex != nullptr) {
+            sohTex[sohE] = (void*)gSoh3DEyeTexture[sohE];
+        }
+        if (sohDepth != nullptr) {
+            sohDepth[sohE] = (void*)gSoh3DEyeDepthTexture[sohE];
+        }
+        if (sohTag != nullptr) {
+            sohTag[sohE] = gSoh3DEyeTag[sohE];
+        }
+    }
 }
 
+void GfxRenderingAPIMetal::Soh3DSetFbClearAlphaZero(int fb) {
+    mSoh3DAlphaZeroFb = fb;
+}
+
+void GfxRenderingAPIMetal::Soh3DPublishOnComplete(int fb, int eyeIdx, unsigned int tag) {
+    sSoh3DPublishFb = fb;
+    sSoh3DPublishEye = eyeIdx;
+    sSoh3DPublishTag = tag;
+}
+
+void GfxRenderingAPIMetal::EndFrameOffscreen() {
+    for (int sohFbId : mDrawnFramebuffers) {
+        auto& sohFb = mFramebuffers[sohFbId];
+        if (sohFb.mCommandBuffer == nullptr) {
+            continue;
+        }
+        if (!sohFb.mHasEndedEncoding && sohFb.mCommandEncoder != nullptr) {
+            sohFb.mCommandEncoder->endEncoding();
+        }
+        if (!sSohIosPendingMips.empty()) {
+            MTL::BlitCommandEncoder* sohBlit = sohFb.mCommandBuffer->blitCommandEncoder();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohBlit->generateMipmaps(sohTex);
+            }
+            sohBlit->endEncoding();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohTex->release();
+            }
+            sSohIosPendingMips.clear();
+        }
+        // rev11: attach the completion-publish for the requested eye fb —
+        // the compositor must never see a texture whose frame is mid-GPU
+        // (its unfenced cross-queue blit captures every pass EXCEPT the
+        // final one, which holds the ImGui overlay; device-only, the sim
+        // serializes queues).
+        if (sohFbId == sSoh3DPublishFb) {
+            MTL::Texture* sohPubTex = mTextures[sohFb.mTextureId].texture;
+            MTL::Texture* sohPubDepth = sohFb.mDepthTexture;
+            int sohPubEye = sSoh3DPublishEye;
+            unsigned int sohPubTag = sSoh3DPublishTag;
+            sSoh3DPublishFb = -1;
+            if (sohPubTex != nullptr && sohPubEye >= 0 && sohPubEye <= 2) {
+                sohPubTex->retain();
+                if (sohPubDepth != nullptr) {
+                    sohPubDepth->retain();
+                }
+                sohFb.mCommandBuffer->addCompletedHandler(
+                    MTL::HandlerFunction([sohPubTex, sohPubDepth, sohPubEye,
+                                          sohPubTag](MTL::CommandBuffer* sohCb) {
+                        std::lock_guard<std::mutex> sohLock(sSoh3DPublishMutex);
+                        void* sohOld = (void*)gSoh3DEyeTexture[sohPubEye];
+                        void* sohOldD = (void*)gSoh3DEyeDepthTexture[sohPubEye];
+                        gSoh3DEyeTexture[sohPubEye] = (void*)sohPubTex;
+                        gSoh3DEyeDepthTexture[sohPubEye] = (void*)sohPubDepth;
+                        // rev14: the tag is written LAST inside the same
+                        // critical section the snapshot reads under, so a
+                        // reader can never see a new tag on an old texture.
+                        gSoh3DEyeTag[sohPubEye] = sohPubTag;
+                        // Retire BOTH through the same ring: the VR blit
+                        // samples colour and depth in one pass, so they
+                        // must not outlive each other.
+                        void* sohRetire[2] = { sohOld, sohOldD };
+                        for (int sohR = 0; sohR < 2; sohR++) {
+                            if (sohRetire[sohR] == nullptr) {
+                                continue;
+                            }
+                            void* sohSlot = sSoh3DRetired[sSoh3DRetiredIdx];
+                            if (sohSlot != nullptr) {
+                                ((MTL::Texture*)sohSlot)->release();
+                            }
+                            sSoh3DRetired[sSoh3DRetiredIdx] = sohRetire[sohR];
+                            sSoh3DRetiredIdx = (sSoh3DRetiredIdx + 1) % 16;
+                        }
+                    }));
+            }
+        }
+        sohFb.mCommandBuffer->commit();
+    }
+    // SOH_IOS (overlay 0031 rev17, VR R8 part C): THE PENDING-MIP LEAK.
+    // The drain above lives INSIDE the loop and the loop `continue`s on a
+    // null command buffer, so a walk that uploaded textures and ended with
+    // mDrawnFramebuffers empty (or all-null) neither released nor cleared the
+    // vector: every one of those textures kept a full retain, and the next
+    // frame pushed them again with another one. In VR there are THREE walks
+    // per host frame and the HUD walk is the one most likely to draw nothing.
+    // Whatever is still pending here gets its mips on a command buffer of its
+    // own -- safe, because every framebuffer command buffer above has already
+    // been committed, which is exactly the condition 0019 rev4's mid-frame
+    // deadlock rule is about -- and is then released exactly once.
+    if (!sSohIosPendingMips.empty()) {
+        gSohIosMipOrphans += (unsigned long long)sSohIosPendingMips.size();
+        MTL::CommandBuffer* sohOrphanCb = mCommandQueue->commandBuffer();
+        if (sohOrphanCb != nullptr) {
+            MTL::BlitCommandEncoder* sohOrphanBlit = sohOrphanCb->blitCommandEncoder();
+            for (MTL::Texture* sohTex : sSohIosPendingMips) {
+                sohOrphanBlit->generateMipmaps(sohTex);
+            }
+            sohOrphanBlit->endEncoding();
+            sohOrphanCb->commit();
+        }
+        for (MTL::Texture* sohTex : sSohIosPendingMips) {
+            sohTex->release();
+        }
+        sSohIosPendingMips.clear();
+    }
+    mDrawnFramebuffers.clear();
+    mCurrentVertexBufferPoolIndex = (mCurrentVertexBufferPoolIndex + 1) % kMaxVertexBufferPoolSize;
+    for (int fb_id = 0; fb_id < (int)mFramebuffers.size(); fb_id++) {
+        FramebufferMetal& fb = mFramebuffers[fb_id];
+        fb.mLastShaderProgram = nullptr;
+        fb.mCommandBuffer = nullptr;
+        fb.mCommandEncoder = nullptr;
+        fb.mHasEndedEncoding = false;
+        fb.mHasBoundVertexShader = false;
+        fb.mHasBoundFragShader = false;
+        for (int i = 0; i < SHADER_MAX_TEXTURES; i++) {
+            fb.mLastBoundTextures[i] = nullptr;
+            fb.mLastBoundSamplers[i] = nullptr;
+        }
+        memset(fb.mViewport, 0, sizeof(MTL::Viewport));
+        memset(fb.mScissorRect, 0, sizeof(MTL::ScissorRect));
+        fb.mLastDepthTest = -1;
+        fb.mLastDepthMask = -1;
+        fb.mLastZmodeDecal = -1;
+    }
+    mFrameAutoreleasePool->release();
+}
+
+// SOH_IOS (overlay 0031 rev8): stereo-3D menu — prime ImGui_ImplMetal with
+// an EYE framebuffer's pass descriptor, then render the built draw data
+// into each eye's still-open encoder. FramebufferScale recomputed against
+// the EYE texture (SDL2 ImGui backend reports POINTS on iOS; 0010's fix).
+void GfxRenderingAPIMetal::Soh3DImGuiPrime(int fb) {
+    if (fb < 0 || fb >= (int)mFramebuffers.size()) {
+        return;
+    }
+    MTL::RenderPassDescriptor* sohPass = mFramebuffers[fb].mRenderPassDescriptor;
+    if (sohPass != nullptr) {
+        ImGui_ImplMetal_NewFrame(sohPass);
+    }
+}
+
+extern "C" volatile int gSoh3DDbgMenuDraws;
+#ifndef __IOS__
+extern "C" {
+__attribute__((weak)) volatile int gSoh3DDbgMenuDraws = 0; // rev13: see above
+}
+#endif
+
+void GfxRenderingAPIMetal::Soh3DImGuiRender(int fb, void* drawData) {
+    if (fb < 0 || fb >= (int)mFramebuffers.size() || drawData == nullptr) {
+        return;
