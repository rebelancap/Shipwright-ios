+ * predicate. Defined in app/ios/SohSense.m, which soh/CMakeLists.txt compiles
+ * ONLY for visionOS -- so the reference has to be visionOS-only too, or the
+ * iPhone link fails on two undefined symbols (rev1 did exactly that). A Sense
+ * pair is a visionOS-only input path; iPhone keeps the vanilla enumeration.
+ * TARGET_OS_VISION, not SOH_VISIONOS: this file is libultraship, which never
+ * sees soh's target defines. */
+extern "C" int SohSense_IsSpatialControllerName(const char* name);
+extern "C" void SohSense_NoteSdlSpatialSkip(void);
+#endif
+
 namespace Ship {
 ConnectedPhysicalDeviceManager::ConnectedPhysicalDeviceManager() {
 }
