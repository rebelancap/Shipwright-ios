+/* --------------------------------------------------------------------------
+ * DRAW. Called at the end of Play_Draw's actor pass, where POLY_XLU is open.
+ * ------------------------------------------------------------------------ */
+/* R19 part B: `tmax` is the texture's last texel index -- 31 for the 32x32 item
+ * icons and the untextured quads (whose texcoords nothing reads), 63 for the
+ * 64x64 ring. Before this it was hardcoded 31, which would have sampled a
+ * quarter of the ring. */
+static s32 SohVrSel_PushQuad(Vec3f at, Vec3f camRight, Vec3f camUp, f32 hs, s32 tmax) {
+    s32 base;
+    f32 rx;
+    f32 ry;
+    f32 rz;
+    f32 ux;
+    f32 uy;
+    f32 uz;
+
+    if ((sSohSelVtxUsed + 4) > SOH_SEL_MAX_VTX) {
+        return -1;
+    }
+    base = sSohSelVtxUsed;
+    rx = camRight.x * hs;
+    ry = camRight.y * hs;
+    rz = camRight.z * hs;
+    ux = camUp.x * hs;
+    uy = camUp.y * hs;
+    uz = camUp.z * hs;
+
+#define SOH_SEL_V(i, X, Y, Z, S, T)                            \
+    sSohSelVtx[base + (i)].v.ob[0] = (s16)(X);                 \
+    sSohSelVtx[base + (i)].v.ob[1] = (s16)(Y);                 \
+    sSohSelVtx[base + (i)].v.ob[2] = (s16)(Z);                 \
+    sSohSelVtx[base + (i)].v.flag = 0;                         \
+    sSohSelVtx[base + (i)].v.tc[0] = (s16)(S);                 \
+    sSohSelVtx[base + (i)].v.tc[1] = (s16)(T);                 \
+    sSohSelVtx[base + (i)].v.cn[0] = 255;                      \
+    sSohSelVtx[base + (i)].v.cn[1] = 255;                      \
+    sSohSelVtx[base + (i)].v.cn[2] = 255;                      \
+    sSohSelVtx[base + (i)].v.cn[3] = 255
+
+    /* Top-left, top-right, bottom-left, bottom-right; t grows downward. */
+    SOH_SEL_V(0, at.x - rx + ux, at.y - ry + uy, at.z - rz + uz, 0, 0);
+    SOH_SEL_V(1, at.x + rx + ux, at.y + ry + uy, at.z + rz + uz, tmax << 5, 0);
+    SOH_SEL_V(2, at.x - rx - ux, at.y - ry - uy, at.z - rz - uz, 0, tmax << 5);
+    SOH_SEL_V(3, at.x + rx - ux, at.y + ry - uy, at.z + rz - uz, tmax << 5, tmax << 5);
+#undef SOH_SEL_V
+
+    sSohSelVtxUsed += 4;
+    return base;
+}
+
+void SohVrItemSel_Draw(PlayState* play) {
+    Gfx* p;
+    Vec3f camUp;
+    Vec3f camRight;
+    Vec3f camFwd;
+    f32 crl;
+    f32 th;
+    f32 ringR;
+    f32 iconHs;
+    f32 giScale;
+    s32 use3d;
+    s32 i;
+    s32 base;
+    s32 sectors[4];
+    Vec3f at[4];
+    u8 items[4];
+    s32 gid[4];
+
+    if (!sSohSelOpen || (play == NULL) || (gSohVRItemSel == 0)) {
+        return;
+    }
+
+    p = sSohSelDl;
+    sSohSelVtxUsed = 0;
+
+    /* Billboard axes. Up is the world's, not the camera's: the compass is read
+     * standing up, and a head roll that tilts four icons is nausea, not
+     * polish. The donor uses the camera's up because a PCVR headset's roll is
+     * usually zero; ours is not guaranteed to be. */
+    camUp.x = 0.0f;
+    camUp.y = 1.0f;
+    camUp.z = 0.0f;
+    camRight.x = -gSoh3DCamFwd[2];
+    camRight.y = 0.0f;
+    camRight.z = gSoh3DCamFwd[0];
+    crl = sqrtf((camRight.x * camRight.x) + (camRight.z * camRight.z));
+    if (crl > 1e-3f) {
+        camRight.x /= crl;
+        camRight.z /= crl;
+    } else {
+        camRight.x = 1.0f;
+        camRight.z = 0.0f;
+    }
+    /* R18 part C: the halo is pushed AWAY from the eye along this. */
+    camFwd.x = gSoh3DCamFwd[0];
+    camFwd.y = gSoh3DCamFwd[1];
+    camFwd.z = gSoh3DCamFwd[2];
+
+    th = SohVrSel_ThresholdUnits();
+    /* Icons sit just past the pick threshold -- you flick INTO them -- with
+     * size floors so a short flick distance cannot shrink the compass into
+     * unreadability (donor's numbers). Unchanged by R18 part C on purpose:
+     * this radius is where the wearer's hand has learned to flick, and a
+     * smaller ring cannot help a depth-tested model anyway (see the patch
+     * header). The 3D size rides the scale term instead. */
+    ringR = (th * 1.5f > 4.5f) ? (th * 1.5f) : 4.5f;
+    iconHs = (th * 0.55f > 1.6f) ? (th * 0.55f) : 1.6f;
+    giScale = SohVrSel_GiScale(ringR);
+    use3d = (gSohVRWheel3D != 0);
+
+    /* equips.buttonItems: 0 = B (sword), 1/2/3 = C-left / C-down / C-right. */
+    sectors[0] = SOH_SEL_UP;
+    at[0].x = 0.0f;
+    at[0].y = ringR;
+    at[0].z = 0.0f;
+    items[0] = gSaveContext.equips.buttonItems[0];
+    sectors[1] = SOH_SEL_DOWN;
+    at[1].x = 0.0f;
+    at[1].y = -ringR;
+    at[1].z = 0.0f;
+    items[1] = gSaveContext.equips.buttonItems[2];
+    sectors[2] = SOH_SEL_LEFT;
+    at[2].x = -sSohSelHeadRight.x * ringR;
+    at[2].y = 0.0f;
+    at[2].z = -sSohSelHeadRight.z * ringR;
+    items[2] = gSaveContext.equips.buttonItems[1];
+    sectors[3] = SOH_SEL_RIGHT;
+    at[3].x = sSohSelHeadRight.x * ringR;
+    at[3].y = 0.0f;
+    at[3].z = sSohSelHeadRight.z * ringR;
+    items[3] = gSaveContext.equips.buttonItems[3];
+
+    /* Which slots the 3D arm will take. A slot the table has no model for --
+     * and every slot at all with `vr set wheel3d 0` -- keeps the icon quad. */
+    for (i = 0; i < 4; i++) {
+        gid[i] = use3d ? SohVrSel_Gid(items[i]) : SOH_SEL_GID_NONE;
+    }
+
+    /* Textured XLU billboards with no Z compare or write: the compass is UI and
+     * is never occluded by the world it floats in. The anchor rides a RECORDED
+     * matrix so frame interpolation glides it at render rate -- without that it
+     * is the one thing on screen visibly stepping at 20 Hz, because it is the
+     * one thing anchored to a hand. */
+    FrameInterpolation_RecordOpenChild((const void*)sSohSelDl, 0);
+    Matrix_Translate(sSohSelAnchor.x, sSohSelAnchor.y, sSohSelAnchor.z, MTXMODE_NEW);
+    gSPMatrix(p++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_MODELVIEW | G_MTX_LOAD | G_MTX_NOPUSH);
+    FrameInterpolation_RecordCloseChild();
+    gDPPipeSync(p++);
+    gDPSetCycleType(p++, G_CYC_1CYCLE);
+    gDPSetRenderMode(p++, G_RM_XLU_SURF, G_RM_XLU_SURF2);
+    gDPSetTextureFilter(p++, G_TF_BILERP);
+    gSPClearGeometryMode(p++, G_CULL_BOTH | G_LIGHTING);
+    gSPTexture(p++, 0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_ON);
+
+    for (i = 0; i < 4; i++) {
+        s32 selected = (sSohSelSector == sectors[i]);
+        /* R20 (D-075): 1.35 again -- see SohVrSel_SelScale, whose midpoint this
+         * is. The icon path takes the midpoint of the breath rather than the
+         * breath itself; a pulsing flat sticker reads as a glitch, a pulsing
+         * model reads as alive. */
+        f32 hs = selected ? (iconHs * 1.35f) : iconHs;
+
+        if (gid[i] != SOH_SEL_GID_NONE) {
+            /* R18 part C: a 3D model owns this slot, drawn after this display
+             * list. The only quad it gets is the selection marker, and only
+             * while it is the pick -- SETUPDL_25 spends the prim colour on the
+             * fog term, so a lit model cannot be brightened the way the donor
+             * brightened an icon. The marker is the one quad here that IS depth
+             * tested, and it is pushed back by the model's own half extent so
+             * the model occludes its middle and a rim of light is what shows.
+             *
+             * R19 part B (D-073): it is a thin gold RING now, not a solid
+             * yellow tile -- the user's "big yellow square". gLensFlareRingTex is
+             * gameplay_keep's own annulus and vanilla's lens flare draws it with
+             * this exact combiner (colour = PRIMITIVE, alpha = TEXEL0 * PRIM);
+             * `vr set wheelhalo 2` swaps it for a soft round glow and 0 removes
+             * it, leaving only the breath. */
+            if (selected && (gSohVRWheelHalo != 0)) {
+                f32 half = SOH_SEL_GI_UNITS * 0.5f * giScale * SohVrSel_SelScale(play);
+                s32 ring = (gSohVRWheelHalo != 2);
+                Vec3f haloAt;
+
+                haloAt.x = at[i].x + (camFwd.x * half);
+                haloAt.y = at[i].y + (camFwd.y * half);
+                haloAt.z = at[i].z + (camFwd.z * half);
+                /* 1.25, not 1.6: the ring has to READ as a border round the
+                 * model, and 1.6 put its band most of the way to the next
+                 * slot. */
+                base = SohVrSel_PushQuad(haloAt, camRight, camUp, half * 1.25f, ring ? 63 : 31);
+                if (base >= 0) {
+                    gDPPipeSync(p++);
+                    gDPSetRenderMode(p++, G_RM_ZB_XLU_SURF, G_RM_ZB_XLU_SURF2);
+                    gDPSetCombineLERP(p++, 0, 0, 0, PRIMITIVE, TEXEL0, 0, PRIMITIVE, 0, 0, 0, 0, PRIMITIVE, TEXEL0, 0,
+                                      PRIMITIVE, 0);
+                    gDPSetPrimColor(p++, 0, 0, 255, 236, 186, 105);
+                    if (ring) {
+                        gDPLoadTextureBlock_4b(p++, gLensFlareRingTex, G_IM_FMT_I, 64, 64, 0,
+                                               G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMIRROR | G_TX_CLAMP, 6, 6,
+                                               G_TX_NOLOD, G_TX_NOLOD);
+                    } else {
+                        gDPLoadTextureBlock(p++, gUnknownCircle6Tex, G_IM_FMT_I, G_IM_SIZ_8b, 32, 32, 0,
+                                            G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMIRROR | G_TX_CLAMP, 5, 5, G_TX_NOLOD,
+                                            G_TX_NOLOD);
+                    }
+                    gSPVertex(p++, (uintptr_t)&sSohSelVtx[base], 4, 0);
+                    gSP2Triangles(p++, 0, 1, 2, 0, 2, 1, 3, 0);
+                    gDPPipeSync(p++);
+                    gDPSetRenderMode(p++, G_RM_XLU_SURF, G_RM_XLU_SURF2);
+                }
+            }
+            continue;
+        }
+
+        base = SohVrSel_PushQuad(at[i], camRight, camUp, hs, 31);
+        if (base < 0) {
+            break;
+        }
+        if (items[i] < 158) {
+            gDPSetCombineMode(p++, G_CC_MODULATERGBA_PRIM, G_CC_MODULATERGBA_PRIM);
+            if (selected) {
+                gDPSetPrimColor(p++, 0, 0, 255, 255, 255, 255);
+            } else {
+                gDPSetPrimColor(p++, 0, 0, 165, 165, 165, 185);
+            }
+            gDPLoadTextureBlock(p++, gItemIcons[items[i]], G_IM_FMT_RGBA, G_IM_SIZ_32b, 32, 32, 0,
+                                G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMIRROR | G_TX_CLAMP, 5, 5, G_TX_NOLOD,
+                                G_TX_NOLOD);
+        } else {
+            /* Empty slot: a dim placeholder diamond, so the compass always has
+             * four directions and the muscle memory never has to check. */
+            gDPSetCombineMode(p++, G_CC_PRIMITIVE, G_CC_PRIMITIVE);
+            gDPSetPrimColor(p++, 0, 0, 120, 120, 120, selected ? 160 : 90);
+        }
+        gSPVertex(p++, (uintptr_t)&sSohSelVtx[base], 4, 0);
+        gSP2Triangles(p++, 0, 1, 2, 0, 2, 1, 3, 0);
+    }
+
+    /* Centre: the "empty hands" marker, brighter while it is the pick. */
+    {
+        Vec3f centre;
+
+        centre.x = 0.0f;
+        centre.y = 0.0f;
+        centre.z = 0.0f;
+        base = SohVrSel_PushQuad(centre, camRight, camUp,
+                                 (sSohSelSector == SOH_SEL_CENTER) ? (iconHs * 0.55f) : (iconHs * 0.35f), 31);
+        if (base >= 0) {
+            gDPSetCombineMode(p++, G_CC_PRIMITIVE, G_CC_PRIMITIVE);
+            if (sSohSelSector == SOH_SEL_CENTER) {
+                gDPSetPrimColor(p++, 0, 0, 255, 250, 210, 235);
+            } else {
+                gDPSetPrimColor(p++, 0, 0, 190, 190, 190, 130);
+            }
+            gSPVertex(p++, (uintptr_t)&sSohSelVtx[base], 4, 0);
+            gSP2Triangles(p++, 0, 1, 2, 0, 2, 1, 3, 0);
+        }
+    }
+
+    gSPEndDisplayList(p++);
+
+    OPEN_DISPS(play->state.gfxCtx);
+    gSPDisplayList(POLY_XLU_DISP++, sSohSelDl);
+    CLOSE_DISPS(play->state.gfxCtx);
+    gSohVRItemSelDraws = gSohVRItemSelDraws + 1;
+
+    /* ----------------------------------------------------------------------
+     * R18 part C: the 3D arm. The get-item draw funcs emit into POLY_OPA /
+     * POLY_XLU themselves and open their own disps, so nothing of ours may be
+     * open here. Lights and the hilite pair go in ONCE, before the loop.
+     * -------------------------------------------------------------------- */
+    if (!use3d) {
+        return;
+    }
+    if ((gid[0] == SOH_SEL_GID_NONE) && (gid[1] == SOH_SEL_GID_NONE) && (gid[2] == SOH_SEL_GID_NONE) &&
+        (gid[3] == SOH_SEL_GID_NONE)) {
+        return;
+    }
+
+    SohVrSel_BindLights(play);
+
+    for (i = 0; i < 4; i++) {
+        f32 s = giScale;
+
+        if (gid[i] == SOH_SEL_GID_NONE) {
+            continue;
+        }
+        if (sSohSelSector == sectors[i]) {
+            /* R19 part B (D-073): the breath, the same one the marker sizes
+             * itself against, so the ring hugs the model at every phase. */
+            s *= SohVrSel_SelScale(play);
+        }
+        if (gid[i] == SOH_SEL_GID_MSWORD) {
+            s *= SOH_SEL_MSWORD_MUL;
+        } else {
+            s *= SohVrSel_GidScale((u8)gid[i]);
+        }
+
+        /* One recorded child per slot, so every model glides at render rate
+         * and spins smoothly instead of stepping four times a second. Slot 0
+         * of this key belongs to the compass's own anchor matrix above. */
+        FrameInterpolation_RecordOpenChild((const void*)sSohSelDl, 1 + i);
+        Matrix_Translate(sSohSelAnchor.x + at[i].x, sSohSelAnchor.y + at[i].y, sSohSelAnchor.z + at[i].z,
+                         MTXMODE_NEW);
+        /* The get-item spin, at Player_DrawGetItemImpl's own rate. */
+        Matrix_RotateZYX(0, play->gameplayFrames * 1000, 0, MTXMODE_APPLY);
+        Matrix_Scale(s, s, s, MTXMODE_APPLY);
+        if (gid[i] == SOH_SEL_GID_MSWORD) {
+            SohVrSel_DrawMasterSword(play);
+        } else {
+            GetItem_Draw(play, (s16)gid[i]);
+        }
+        FrameInterpolation_RecordCloseChild();
+        gSohVRItemSelModels = gSohVRItemSelModels + 1;
+    }
+}
