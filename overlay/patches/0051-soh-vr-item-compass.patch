+/* --------------------------------------------------------------------------
+ * TICK. Called from the top of the player's update, beside overlay 0048's.
+ * ------------------------------------------------------------------------ */
+void SohVrItemSel_Update(PlayState* play, Player* this, Input* input) {
+    s32 avail = SohVrSel_Available(play);
+    s32 held;
+    s32 selHand = SohVrSel_Hand();
+    Vec3f pos;
+    f32 dx;
+    f32 dy;
+    f32 dz;
+    f32 lat;
+    f32 vert;
+    f32 r;
+    f32 th;
+    s32 newSector;
+
+    sSohSelPlay = play;
+    gSohVRItemSelCalls = gSohVRItemSelCalls + 1;
+    gSohVRItemSelAvail = avail;
+    gSohVRItemSelBtnSeen = ((selHand >= 0) && (selHand <= 1)) ? gSohVRSenseBtn[selHand] : 0u;
+
+    if (!sSohSelOpen) {
+        s32 hand = selHand;
+
+        if (avail && ((gSohVRSenseBtn[hand] & gSohVRItemSelBtn) != 0) && SohVrSel_HandPos(hand, &pos)) {
+            f32 rl;
+            Vec3f right;
+
+            /* Camera right = fwd x up, flattened to the horizon so left/right
+             * stay level even when looking up or down (donor's comment, and it
+             * is what stops a glance at the ceiling rotating the compass). */
+            right.x = -gSoh3DCamFwd[2];
+            right.y = 0.0f;
+            right.z = gSoh3DCamFwd[0];
+            rl = sqrtf((right.x * right.x) + (right.z * right.z));
+            if (rl > 1e-3f) {
+                right.x /= rl;
+                right.z /= rl;
+            } else {
+                right.x = 1.0f;
+                right.z = 0.0f;
+            }
+
+            sSohSelAnchor = pos;
+            sSohSelAnchorOff.x = pos.x - this->actor.world.pos.x;
+            sSohSelAnchorOff.y = pos.y - this->actor.world.pos.y;
+            sSohSelAnchorOff.z = pos.z - this->actor.world.pos.z;
+            sSohSelHeadRight = right;
+            sSohSelHand = hand;
+            sSohSelSector = SOH_SEL_CENTER;
+            sSohSelOpen = 1;
+            gSohVRItemSelOpen = 1;
+            gSohVRItemSelHand = hand;
+            gSohVRItemSelSector = SOH_SEL_CENTER;
+            gSohVRItemSelOpens = gSohVRItemSelOpens + 1;
+            gSohVRItemSelTickSeq = gSohVRItemSelTickSeq + 1u; /* the open tick */
+        }
+        return;
+    }
+
+    /* Open. Losing availability -- a cutscene starts, the mode goes off, a
+     * transition fires -- CANCELS without executing. */
+    if (!avail) {
+        SohVrSel_Close();
+        return;
+    }
+
+    held = (gSohVRSenseBtn[sSohSelHand] & gSohVRItemSelBtn) != 0;
+
+    /* The compass rides Link's body. */
+    sSohSelAnchor.x = this->actor.world.pos.x + sSohSelAnchorOff.x;
+    sSohSelAnchor.y = this->actor.world.pos.y + sSohSelAnchorOff.y;
+    sSohSelAnchor.z = this->actor.world.pos.z + sSohSelAnchorOff.z;
+
+    if (SohVrSel_HandPos(sSohSelHand, &pos)) {
+        dx = pos.x - sSohSelAnchor.x;
+        dy = pos.y - sSohSelAnchor.y;
+        dz = pos.z - sSohSelAnchor.z;
+        lat = (dx * sSohSelHeadRight.x) + (dz * sSohSelHeadRight.z);
+        vert = dy;
+        r = sqrtf((lat * lat) + (vert * vert));
+        th = SohVrSel_ThresholdUnits();
+        newSector = sSohSelSector;
+
+        if (sSohSelSector == SOH_SEL_CENTER) {
+            if (r >= th) {
+                newSector = (fabsf(lat) >= fabsf(vert)) ? ((lat > 0.0f) ? SOH_SEL_RIGHT : SOH_SEL_LEFT)
+                                                        : ((vert > 0.0f) ? SOH_SEL_UP : SOH_SEL_DOWN);
+            }
+        } else if (r < (th * 0.65f)) {
+            newSector = SOH_SEL_CENTER; /* hysteresis: come well back in */
+        } else {
+            s32 curLateral = (sSohSelSector == SOH_SEL_LEFT) || (sSohSelSector == SOH_SEL_RIGHT);
+            f32 curMag = curLateral ? fabsf(lat) : fabsf(vert);
+            f32 othMag = curLateral ? fabsf(vert) : fabsf(lat);
+
+            /* A 15 % lead is required to leave the current sector, so the
+             * boundary between two adjacent directions cannot flicker. */
+            if (othMag > (curMag * 1.15f)) {
+                newSector = curLateral ? ((vert > 0.0f) ? SOH_SEL_UP : SOH_SEL_DOWN)
+                                       : ((lat > 0.0f) ? SOH_SEL_RIGHT : SOH_SEL_LEFT);
+            } else if (curLateral) {
+                newSector = (lat > 0.0f) ? SOH_SEL_RIGHT : SOH_SEL_LEFT;
+            } else {
+                newSector = (vert > 0.0f) ? SOH_SEL_UP : SOH_SEL_DOWN;
+            }
+        }
+        if (newSector != sSohSelSector) {
+            sSohSelSector = newSector;
+            gSohVRItemSelSector = newSector;
+            gSohVRItemSelTickSeq = gSohVRItemSelTickSeq + 1u; /* the Alyx tick */
+        }
+    }
+
+    if (!held) {
+        s32 pick = sSohSelSector;
+
+        SohVrSel_Close();
+        SohVrSel_Execute(play, this, input, pick);
+    }
+}
