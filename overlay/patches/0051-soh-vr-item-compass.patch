+/* ITEM_SWORD_MASTER's model, which is SoH's own answer to the same gap:
+ * Randomizer_DrawMasterSword (soh/soh/Enhancements/randomizer/draw.cpp) draws
+ * the Temple of Time pedestal sword. These are that function's lines, in C, so
+ * the wheel neither links the randomizer's C++ TU nor hands it a NULL
+ * GetItemEntry. The scale factor is applied by the caller. */
+static void SohVrSel_DrawMasterSword(PlayState* play) {
+    OPEN_DISPS(play->state.gfxCtx);
+
+    Gfx_SetupDL_25Opa(play->state.gfxCtx);
+    gSPSegment(POLY_OPA_DISP++, 0x08,
+               Gfx_TwoTexScrollEx(play->state.gfxCtx, 0, 1 * (play->state.frames * 1), 0, 32, 32, 1, 0, 0, 32, 32, 1,
+                                  0, 0, 0));
+    Matrix_RotateZ(2.1f, MTXMODE_APPLY);
+    gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_MODELVIEW | G_MTX_LOAD);
+    gSPDisplayList(POLY_OPA_DISP++, object_toki_objects_DL_001BD0);
+
+    CLOSE_DISPS(play->state.gfxCtx);
+}
