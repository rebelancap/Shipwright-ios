+/* Lights and the hilite/lookat pair, bound ONCE at the wheel's anchor before
+ * any model is drawn. Copied from Actor_Draw (z_actor.c) and func_8002EBCC /
+ * func_8002ED80 with flag 0 -- which is the flag En_GirlA's hiliteFunc and
+ * EnItem00's 3D drops pass, so no get-item display list depends on segment 7
+ * being written here either. Without this the models draw unlit and black:
+ * Gfx_SetupDL_25Opa turns G_LIGHTING ON, and the icon quads never needed it. */
+static void SohVrSel_BindLights(PlayState* play) {
+    Lights* lights;
+    Vec3f lightDir;
+
+    lights = LightContext_NewLights(&play->lightCtx, play->state.gfxCtx);
+    Lights_BindAll(lights, play->lightCtx.listHead, &sSohSelAnchor);
+    Lights_Draw(lights, play->state.gfxCtx);
+
+    lightDir.x = play->envCtx.dirLight1.params.dir.x;
+    lightDir.y = play->envCtx.dirLight1.params.dir.y;
+    lightDir.z = play->envCtx.dirLight1.params.dir.z;
+    func_8002EABC(&sSohSelAnchor, &play->view.eye, &lightDir, play->state.gfxCtx);
+    func_8002EB44(&sSohSelAnchor, &play->view.eye, &lightDir, play->state.gfxCtx);
+}
