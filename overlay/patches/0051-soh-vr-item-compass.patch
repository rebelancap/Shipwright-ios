+/* Per-GID size corrections. There is no such table in the game, so these are
+ * ratios of MEASURED bounding boxes out of the extracted archive against the
+ * 65-unit norm the base scale assumes: object_gi_sutaru 144, zoramask 106,
+ * egg 80. The skull-token rows cannot be reached from a B or C button today;
+ * they are kept because they are the two entries with the largest measured
+ * departure and they are what the list exists to hold. */
+typedef struct {
+    /* 0x00 */ u8 gid;
+    /* 0x04 */ f32 mul;
+} SohSelGidScale;
+
+static const SohSelGidScale sSohSelGidScale[] = {
+    { GID_SKULL_TOKEN, 0.45f },   /* object_gi_sutaru, 144 units */
+    { GID_SKULL_TOKEN_2, 0.45f }, /* the same model out of OBJECT_ST */
+    { GID_MASK_ZORA, 0.60f },     /* object_gi_zoramask, 106 units */
+    { GID_EGG, 0.80f },           /* object_gi_egg, 80 units */
+};
+
+/* The typical get-item model's largest bounding-box extent, in raw model
+ * units, measured across every objects/object_gi_* Vtx resource in the O2R
+ * (45..80, clustered on 65). Everything about the wheel's 3D sizing is
+ * expressed against this one number. */
+#define SOH_SEL_GI_UNITS 65.0f
+/* ringR -> base scale: a typical model spans ~0.62 of the gap between two
+ * adjacent slots (ringR * sqrt(2)), i.e. 0.62 * 1.414 / 65. */
+#define SOH_SEL_GI_PER_RING 0.0135f
+/* object_toki_objects_DL_001BD0's vertices span 1670 units: 65/1670. */
+#define SOH_SEL_MSWORD_MUL 0.039f
+
+static s32 SohVrSel_Gid(u8 item) {
+    if (item == ITEM_SWORD_MASTER) {
+        return SOH_SEL_GID_MSWORD;
+    }
+    if (item >= ARRAY_COUNT(sSohSelGid)) {
+        return SOH_SEL_GID_NONE;
+    }
+    if (sSohSelGid[item] == SOH_SEL_NO_GID) {
+        return SOH_SEL_GID_NONE;
+    }
+    return sSohSelGid[item];
+}
+
+static f32 SohVrSel_GidScale(u8 gid) {
+    s32 i;
+
+    for (i = 0; i < ARRAY_COUNT(sSohSelGidScale); i++) {
+        if (sSohSelGidScale[i].gid == gid) {
+            return sSohSelGidScale[i].mul;
+        }
+    }
+    return 1.0f;
+}
+
+/* R19 part B (D-073), resized in R20 (D-075): the selected slot BREATHES, and
+ * as of R20 the breath is the ONLY feedback -- the user, on 1.0.1.24: "remove the
+ * orange circle that surrounds your selection; just make the size or zoom of
+ * the object you're selecting a little bigger. That's enough UI feedback along
+ * with the haptics." So 1.35 +/- 0.05 at about 0.7 Hz on the 20 Hz tick clock
+ * (0.35 rad per tick); the bounds are 1.30 .. 1.40 by construction, whatever
+ * the frame counter does.
+ *
+ * 1.35 CLEARS ITS NEIGHBOURS, and the arithmetic is the same one that convicted
+ * R18's marker. A typical 65-unit model at the shipped ring draws 3.95 units
+ * across (65 * ringR * 0.0135 at ringR 4.5) against a 6.36-unit gap between
+ * adjacent slots; at 1.35 it draws 5.33, and the clearance to an unselected
+ * neighbour is 6.36 - 5.33/2 - 3.95/2 = 1.7 units. Even the 1.40 top of the
+ * breath leaves 1.6. Nothing collides. */
+static f32 SohVrSel_SelScale(PlayState* play) {
+    return 1.35f + (0.05f * sinf((f32)play->gameplayFrames * 0.35f));
+}
+
+static f32 SohVrSel_GiScale(f32 ringR) {
+    f32 dial = gSohVRWheelScale;
+
+    if (!(dial > 0.02f)) { /* also catches a NaN that reached the dial */
+        dial = 0.02f;
+    } else if (dial > 4.0f) {
+        dial = 4.0f;
+    }
+    return ringR * SOH_SEL_GI_PER_RING * dial;
+}
