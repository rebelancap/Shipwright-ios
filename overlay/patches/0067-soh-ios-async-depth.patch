+#ifdef __IOS__
+// SOH_IOS (overlay 0067, D-086): asynchronous depth readback. The game asks
+// once per tick (Environment_GraphCallback: sun lens flare + light glows).
+// Upstream commits a compute dispatch and waitUntilCompleted()s it, which on
+// the phone waits for every frame still queued (10-15 ms per tick in the bad
+// windows). Phase 1 (submit, in the callback) commits without waiting; phase 2
+// (harvest, top of the next tick, before any reader) answers the same
+// coordinates from that dispatch. See scripts/gen-patch-0067.py.
+namespace {
+constexpr int kSohZSlots = 4;
+struct SohZSlot {
+    MTL::CommandBuffer* cb = nullptr; // retained while the slot holds data
+    MTL::Buffer* coordBuf = nullptr;  // sizeof(CoordUniforms), the kernel's constant
+    MTL::Buffer* outBuf = nullptr;    // MAX_PIXEL_DEPTH_COORDS floats
+    std::vector<std::pair<float, float>> coords;
+    unsigned long long seq = 0;
+};
+SohZSlot sSohZ[kSohZSlots];
+unsigned long long sSohZSeq = 0;
+int sSohZPhase = 0; // 0 upstream sync, 1 submit, 2 harvest
+unsigned sSohZGen = 0;
+bool sSohZEverDone = false;
+MTL::ComputePipelineState* sSohZPso = nullptr;
+MTL::Function* sSohZPsoFn = nullptr;
+// newest finished dispatch, copied out so a slot can be reused
+std::vector<std::pair<float, float>> sSohZLastCoords;
+std::vector<uint16_t> sSohZLastVals;
+unsigned long long sSohZLastSeq = 0;
+unsigned sSohZStat[9]; // submit skip exact near far sync inflight check_eq check_ne
+// gSohIos.AsyncDepthCheck (default 0, verification only): the submit pass also
+// runs upstream's synchronous readback for the same coordinates and keeps its
+// answer; the harvest compares every exact answer with it (check_eq/ne).
+bool sSohZCheckOn = false;
+std::vector<std::pair<std::pair<float, float>, uint16_t>> sSohZCheck;
+unsigned long long sSohZCheckSeq = 0;
+std::chrono::steady_clock::time_point sSohZWin;
+
+void SohZRetire() {
+    for (auto& s : sSohZ) {
+        if (s.cb == nullptr) {
+            continue;
+        }
+        MTL::CommandBufferStatus st = s.cb->status();
+        if (st == MTL::CommandBufferStatusCompleted) {
+            if (s.seq > sSohZLastSeq) {
+                const float* v = (const float*)s.outBuf->contents();
+                sSohZLastCoords = s.coords;
+                sSohZLastVals.resize(s.coords.size());
+                for (size_t i = 0; i < s.coords.size(); i++) {
+                    sSohZLastVals[i] = v[i] * 65532.0f; // upstream's conversion
+                }
+                sSohZLastSeq = s.seq;
+                sSohZEverDone = true;
+            }
+        } else if (st == MTL::CommandBufferStatusError) {
+            s.cb->release();
+            s.cb = nullptr;
+        }
+    }
+}
+
+uint16_t SohZLookup(const std::pair<float, float>& c, float thr) {
+    const unsigned cnt = sSohZPhase == 2 ? 1u : 0u; // count the harvest only
+    int best = -1;
+    float bestD = thr * thr;
+    for (size_t i = 0; i < sSohZLastCoords.size(); i++) {
+        if (sSohZLastCoords[i] == c) {
+            sSohZStat[2] += cnt;
+            if (cnt && sSohZCheckOn && sSohZCheckSeq == sSohZLastSeq) {
+                for (const auto& kv : sSohZCheck) {
+                    if (kv.first == c) {
+                        sSohZStat[kv.second == sSohZLastVals[i] ? 7 : 8]++;
+                    }
+                }
+            }
+            return sSohZLastVals[i];
+        }
+        float dx = sSohZLastCoords[i].first - c.first, dy = sSohZLastCoords[i].second - c.second;
+        if (dx * dx + dy * dy <= bestD) {
+            bestD = dx * dx + dy * dy;
+            best = (int)i;
+        }
+    }
+    if (best >= 0) {
+        sSohZStat[3] += cnt;
+        return sSohZLastVals[best];
+    }
+    sSohZStat[4] += cnt;
+    return 0xFFFC; // far = not occluded
+}
+
+void SohZLog() {
+    auto now = std::chrono::steady_clock::now();
+    if (sSohZWin.time_since_epoch().count() == 0) {
+        sSohZWin = now;
+        return;
+    }
+    double el = std::chrono::duration<double>(now - sSohZWin).count();
+    if (el < 10.0) {
+        return;
+    }
+    SPDLOG_INFO("SOH_ZASYNC el={:.1f} submit={} skip={} exact={} near={} far={} sync={} inflight={} check_eq={} "
+                "check_ne={}",
+                el, sSohZStat[0], sSohZStat[1], sSohZStat[2], sSohZStat[3], sSohZStat[4], sSohZStat[5], sSohZStat[6],
+                sSohZStat[7], sSohZStat[8]);
+    memset(sSohZStat, 0, sizeof(sSohZStat));
+    sSohZWin = now;
+}
+
+// true = answered into res; false = caller runs the upstream synchronous path.
+bool SohIosAsyncDepth(MTL::Device* dev, MTL::CommandQueue* queue, MTL::Function* fn, bool nonUniform,
+                      MTL::Texture* depthTex, const std::set<std::pair<float, float>>& coordinates,
+                      std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>& res) {
+    if (sSohZPhase == 0 || coordinates.empty() || depthTex == nullptr ||
+        coordinates.size() > MAX_PIXEL_DEPTH_COORDS) {
+        return false;
+    }
+    SohZRetire();
+    SohZLog();
+    if (sSohZPhase == 2) {
+        for (auto& s : sSohZ) {
+            if (s.cb != nullptr && s.cb->status() != MTL::CommandBufferStatusCompleted) {
+                sSohZStat[6]++;
+            }
+        }
+        if (!sSohZEverDone) {
+            sSohZStat[5]++;
+            return false; // first tick ever: one synchronous answer
+        }
+    }
+    const float thr = std::max(8.0f, depthTex->height() / 16.0f);
+    for (const auto& c : coordinates) {
+        res.emplace(c, SohZLookup(c, thr));
+    }
+    if (sSohZPhase != 1) {
+        return true;
+    }
+
+    // Submit: oldest free or finished slot.
+    SohZSlot* slot = nullptr;
+    for (auto& s : sSohZ) {
+        bool sohFree = s.cb == nullptr || s.cb->status() == MTL::CommandBufferStatusCompleted;
+        if (sohFree && (slot == nullptr || s.seq < slot->seq)) {
+            slot = &s;
+        }
+    }
+    if (slot == nullptr) {
+        sSohZStat[1]++;
+        return true;
+    }
+    NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+    if (sSohZPso == nullptr || sSohZPsoFn != fn) {
+        NS::Error* error = nullptr;
+        MTL::ComputePipelineState* pso = dev->newComputePipelineState(fn, &error);
+        if (pso == nullptr) {
+            pool->release();
+            return true; // keep the provisional values; the harvest falls back
+        }
+        if (sSohZPso != nullptr) {
+            sSohZPso->release();
+        }
+        sSohZPso = pso;
+        sSohZPsoFn = fn;
+    }
+    if (slot->cb != nullptr) {
+        slot->cb->release();
+        slot->cb = nullptr;
+    }
+    if (slot->coordBuf == nullptr) {
+        slot->coordBuf = dev->newBuffer(sizeof(CoordUniforms), MTL::ResourceCPUCacheModeDefaultCache);
+        slot->outBuf = dev->newBuffer(sizeof(float) * MAX_PIXEL_DEPTH_COORDS, MTL::ResourceCPUCacheModeDefaultCache);
+    }
+    simd::uint2* cu = (simd::uint2*)slot->coordBuf->contents();
+    slot->coords.assign(coordinates.begin(), coordinates.end());
+    for (size_t i = 0; i < slot->coords.size(); i++) {
+        // identical mapping to upstream (y flipped against the depth texture)
+        cu[i].x = (uint32_t)(int32_t)slot->coords[i].first;
+        cu[i].y = (uint32_t)(int32_t)(depthTex->height() - 1 - slot->coords[i].second);
+    }
+    MTL::CommandBuffer* cb = queue->commandBuffer();
+    cb->setLabel(NS::String::string("Depth Shader Command Buffer (async)", NS::UTF8StringEncoding));
+    MTL::ComputeCommandEncoder* enc = cb->computeCommandEncoder();
+    enc->setComputePipelineState(sSohZPso);
+    enc->setTexture(depthTex, 0);
+    enc->setBuffer(slot->coordBuf, 0, 0);
+    enc->setBuffer(slot->outBuf, 0, 1);
+    MTL::Size tgSize = MTL::Size::Make(1, 1, 1);
+    MTL::Size tgCount = MTL::Size::Make(slot->coords.size(), 1, 1);
+    if (nonUniform) {
+        enc->dispatchThreads(tgCount, tgSize);
+    } else {
+        enc->dispatchThreadgroups(tgCount, tgSize);
+    }
+    enc->endEncoding();
+    cb->commit();
+    slot->cb = cb->retain();
+    slot->seq = ++sSohZSeq;
+    sSohZStat[0]++;
+    pool->release();
+    return true;
+}
+} // namespace
+
+// Phase control for soh (z_kankyo.c). harvest=0: the callback's submit pass;
+// harvest=1: the next tick's re-run. Returns 0 when async is off (or, for a
+// harvest, when nothing was ever submitted) -- the caller then skips the pass.
+extern "C" int SohIos_DepthAsyncBegin(int harvest) {
+    sSohZPhase = 0;
+    if (Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gSohIos.AsyncDepth", 1) == 0) {
+        return 0;
+    }
+    if (harvest && sSohZSeq == 0) {
+        return 0;
+    }
+    sSohZPhase = harvest ? 2 : 1;
+    sSohZGen++;
+    sSohZCheckOn =
+        Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gSohIos.AsyncDepthCheck", 0) != 0;
+    return 1;
+}
+extern "C" void SohIos_DepthAsyncEnd(void) {
+    sSohZPhase = 0;
+}
+extern "C" int SohIos_DepthAsyncPhase(void) {
+    return sSohZPhase;
+}
+extern "C" unsigned SohIos_DepthAsyncGen(void) {
+    return sSohZGen;
+}
+namespace {
+// Check mode: should the submit pass ALSO run the synchronous path, and keep
+// its answer for the harvest to compare against?
+bool SohZCheckWanted() {
+    return sSohZCheckOn && sSohZPhase == 1;
+}
+void SohZCheckRecord(const std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>& res) {
+    sSohZCheck.assign(res.begin(), res.end());
+    sSohZCheckSeq = sSohZSeq;
+}
+} // namespace
+#endif
