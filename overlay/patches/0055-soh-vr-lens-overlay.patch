+/* sohTinted != 0: this is a COLOUR site, so the pass sets its own combiner and
+ * prim colour and repeats itself gSohVRLensTint times. 0: this is the depth
+ * site, whose combiner, prim colour, prim depth and other mode all belong to
+ * the caller and must not be touched -- one rect, exactly one. */
+static void Actor_VrDrawLensOverlay(GraphicsContext* gfxCtx, s32 sohTinted) {
+    f32 sohBuilt;
+    f32 sohEye;
+    f32 sohScale;
+    f32 sohTint;
+    f32 sohRemain;
+    f32 sohDv;
+    f32 sohDh;
+    f32 sohRateS;
+    f32 sohRateT;
+    s32 sohX0;
+    s32 sohX1;
+    s32 sohPasses;
+    s32 sohPass;
+    s32 sohAlpha;
+
+    /* R19 part B (D-073): the WORLD quad, which is the shipped path. Branched
+     * here rather than at the call sites so that BOTH of them and the far-depth
+     * write take it together -- the depth pass writes PRIM depth, so only its
+     * footprint changes, and routing it through the same geometry makes the
+     * hole in the depth mask coincide with the visible circle per eye. `vr set
+     * lensworld 0` is the instant A/B back to the rect below. */
+    if ((gSohVRLensWorld != 0) && (gSohVRCamValid != 0)) {
+        Actor_VrLensQuad(gfxCtx, sohTinted);
+        return;
+    }
+
+    OPEN_DISPS(gfxCtx);
+
+    /* The aspect the GAME laid this list out against (OTRGetAspectRatio is what
+     * OTRGetRectDimensionFrom*Edge below is built on), and the aspect of the eye
+     * it will be rasterised into. With the HUD plane on these differ, which is
+     * the whole reason the circle needs its own s/t rates. */
+    sohBuilt = OTRGetAspectRatio();
+    if (!(sohBuilt > 0.1f)) {
+        sohBuilt = 4.0f / 3.0f;
+    }
+    sohEye = ((gSoh3DEyeW > 0) && (gSoh3DEyeH > 0)) ? ((f32)gSoh3DEyeW / (f32)gSoh3DEyeH) : sohBuilt;
+
+    sohScale = gSohVRLensScale;
+    if (!(sohScale > 0.3f)) {
+        sohScale = 0.3f;
+    }
+    if (sohScale > 2.0f) {
+        sohScale = 2.0f;
+    }
+
+    /* Vanilla's own vertical diameter, re-derived from vanilla's own constants:
+     * 2*LENS_MASK_HEIGHT texels of tile spread over
+     * SCREEN_HEIGHT - 2*LENS_MASK_OFFSET_T screen rows. Dh is then whatever
+     * makes that circle physically ROUND in a field that is sohEye wide and 1
+     * tall while its coordinates are sohBuilt wide and 1 tall. */
+    sohDv = (f32)(2 * LENS_MASK_HEIGHT) * (f32)SCREEN_HEIGHT / (f32)(SCREEN_HEIGHT - 2 * LENS_MASK_OFFSET_T);
+    sohDv *= sohScale;
+    sohDh = sohDv * sohBuilt / sohEye;
+    sohRateS = (f32)(2 * LENS_MASK_WIDTH) / sohDh;
+    sohRateT = (f32)(2 * LENS_MASK_HEIGHT) / sohDv;
+
+    /* EDGE TO EDGE under either aspect: these two helpers exist precisely to
+     * name the field's own edges, so `vr set hudplane 0` (the A/B for 0031's
+     * half of this round) cannot move the lens. */
+    sohX0 = OTRGetRectDimensionFromLeftEdge(0);
+    sohX1 = OTRGetRectDimensionFromRightEdge(SCREEN_WIDTH);
+
+    gDPLoadTextureBlock(POLY_XLU_DISP++, gLensOfTruthMaskTex, G_IM_FMT_I, G_IM_SIZ_8b, LENS_MASK_WIDTH,
+                        LENS_MASK_HEIGHT, 0, G_TX_MIRROR | G_TX_CLAMP, G_TX_MIRROR | G_TX_CLAMP, 6, 6, G_TX_NOLOD,
+                        G_TX_NOLOD);
+    gDPSetTileSize(POLY_XLU_DISP++, G_TX_RENDERTILE, (SCREEN_WIDTH / 2 - LENS_MASK_WIDTH) << 2,
+                   (SCREEN_HEIGHT / 2 - LENS_MASK_HEIGHT) << 2, (SCREEN_WIDTH / 2 + LENS_MASK_WIDTH - 1) << 2,
+                   (SCREEN_HEIGHT / 2 + LENS_MASK_HEIGHT - 1) << 2);
+
+    sohTint = gSohVRLensTint;
+    if (!(sohTint > 1.0f)) {
+        sohTint = 1.0f;
+    }
+    if (sohTint > 6.0f) {
+        sohTint = 6.0f;
+    }
+    sohPasses = (sohTinted != 0) ? (s32)(sohTint + 0.98f) : 1;
+    for (sohPass = 0; sohPass < sohPasses; sohPass++) {
+        if (sohTinted != 0) {
+            /* colour = PRIMITIVE, alpha = TEXEL0 * PRIMITIVE. Vanilla's
+             * G_CC_MODULATEIA_PRIM spends the mask on BOTH, which is why its
+             * ring is a 29 % red as well as a 29 %-opaque one. The first pass
+             * is always full alpha: it is the one whose fragments write the
+             * depth mask at the depth site, and it must cover exactly what
+             * vanilla covered. The centre needs no clamp -- the mask is 0
+             * there, G_AC_THRESHOLD discards it, and 0 * anything is 0. */
+            sohRemain = sohTint - (f32)sohPass;
+            sohAlpha = (sohRemain >= 1.0f) ? 255 : (s32)(255.0f * sohRemain);
+            if (sohAlpha < 1) {
+                sohAlpha = 1;
+            }
+            gDPSetCombineLERP(POLY_XLU_DISP++, 0, 0, 0, PRIMITIVE, TEXEL0, 0, PRIMITIVE, 0, 0, 0, 0, PRIMITIVE, TEXEL0,
+                              0, PRIMITIVE, 0);
+            gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 0, 0, (u8)sohAlpha);
+        }
+        gSPWideTextureRectangle(
+            POLY_XLU_DISP++, sohX0 << 2, 0, sohX1 << 2, SCREEN_HEIGHT << 2, G_TX_RENDERTILE,
+            (s32)((((f32)(SCREEN_WIDTH / 2) - 0.5f) - (((f32)(SCREEN_WIDTH / 2) - (f32)sohX0) * sohRateS)) * 32.0f),
+            (s32)((((f32)(SCREEN_HEIGHT / 2) - 0.5f) - ((f32)(SCREEN_HEIGHT / 2) * sohRateT)) * 32.0f),
+            (s32)(sohRateS * 1024.0f), (s32)(sohRateT * 1024.0f));
+        gSohVRLensDraws = gSohVRLensDraws + 1;
+    }
+    if (sohTinted != 0) {
+        gSohVRLensPasses = sohPasses;
+    }
     gDPPipeSync(POLY_XLU_DISP++);
     CLOSE_DISPS(gfxCtx);
 }
 
+/* Item (iii): NEUTRALISE THE NEAR-PLANE FIELD, AFTER EVERYTHING HAS USED IT.
+ * Vanilla writes prim depth 0 (near) with Z_UPD wherever the mask is opaque,
+ * because that is how the invisible actors get clipped to the circle -- and
+ * overlay 0031 rev13 publishes this eye's depth texture to the compositor,
+ * which then reprojects that whole region as if it were at the wearer's nose.
+ * Called at the very END of Actor_DrawLensActors: the actor loop and the colour
+ * pass have both already run, so the clipping is unaffected and only the
+ * compositor's copy changes. The mode is vanilla's own "update the z-buffer but
+ * not the color frame buffer" (Fast3D reads it as its `invisible` shader
+ * option), and the combiner per lens mode is vanilla's own, so the region
+ * re-written is EXACTLY the region vanilla wrote. */
+static void Actor_VrLensDepthFar(PlayState* play, GraphicsContext* gfxCtx) {
+    OPEN_DISPS(gfxCtx);
+
+    gDPPipeSync(POLY_XLU_DISP++);
+    gDPSetOtherMode(POLY_XLU_DISP++,
+                    G_AD_DISABLE | G_CD_MAGICSQ | G_CK_NONE | G_TC_FILT | G_TF_BILERP | G_TT_NONE | G_TL_TILE |
+                        G_TD_CLAMP | G_TP_NONE | G_CYC_1CYCLE | G_PM_NPRIMITIVE,
+                    G_AC_THRESHOLD | G_ZS_PRIM | Z_UPD | IM_RD | CVG_DST_SAVE | ZMODE_OPA | FORCE_BL |
+                        GBL_c1(G_BL_CLR_BL, G_BL_0, G_BL_CLR_MEM, G_BL_1MA) |
+                        GBL_c2(G_BL_CLR_BL, G_BL_0, G_BL_CLR_MEM, G_BL_1MA));
+    if (play->roomCtx.curRoom.lensMode == LENS_MODE_HIDE_ACTORS) {
+        gDPSetCombineMode(POLY_XLU_DISP++, G_CC_MODULATEIA_PRIM, G_CC_MODULATEIA_PRIM);
+        gDPSetPrimColor(POLY_XLU_DISP++, 0, 0, 255, 255, 255, 255);
+    } else {
+        gDPSetCombineLERP(POLY_XLU_DISP++, PRIMITIVE, TEXEL0, PRIM_LOD_FRAC, 0, PRIMITIVE, TEXEL0, PRIM_LOD_FRAC, 0,
+                          PRIMITIVE, TEXEL0, PRIM_LOD_FRAC, 0, PRIMITIVE, TEXEL0, PRIM_LOD_FRAC, 0);
+        gDPSetPrimColor(POLY_XLU_DISP++, 0, 0xFF, 74, 74, 74, 74);
+    }
+    /* 0x7FFF is Fast3D's own far end of the 15-bit prim-depth register
+     * (interpreter.cpp: "N64 prim_depth is 15-bit (0 near, 0x7FFF far)"). */
+    gDPSetPrimDepth(POLY_XLU_DISP++, 0x7FFF, 0);
+
+    Actor_VrDrawLensOverlay(gfxCtx, 0);
+
+    gDPPipeSync(POLY_XLU_DISP++);
+
+    CLOSE_DISPS(gfxCtx);
+}
