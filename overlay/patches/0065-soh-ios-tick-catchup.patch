+#ifdef __IOS__
+// SOH_IOS (overlay 0065, D-084): the pace probe + tick catch-up state. All of
+// it is touched on the game thread only (the backends call these from
+// NewFrame / SwapBuffersBegin, Graph_ProcessGfxCommands from the tick).
+extern "C" {
+extern volatile int gSoh3DMode;
+int SohIos_PowerState(void); // shell: 1 LPM, 2 charging, 4 full, 8 unknown
+int SohIos_ThermalState(void);
+}
+namespace SohIosPace {
+using Clock = std::chrono::steady_clock;
+static Clock::time_point sDrawBegin{}, sDrawEnd{}, sSleepBegin{};
+static bool sHaveDrawEnd = false;
+static std::vector<double> sWait, sBusy, sSleep, sTick;
+static uint32_t sSkipped = 0, sSkipTicks = 0;
+static double sDebtSum = 0.0, sDebtMax = 0.0;
+static Clock::time_point sLastReport = Clock::now();
+static double Ms(Clock::time_point a, Clock::time_point b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+}
+static double Pct(std::vector<double>& v, double p) {
+    if (v.empty()) {
+        return 0.0;
+    }
+    return v[(size_t)(p * (v.size() - 1))];
+}
+static void StressSpin() {
+    // Test instrument (gSohIos.PaceStressMs): a deliberately slow frame.
+    int ms = CVarGetInteger("gSohIos.PaceStressMs", 0);
+    if (ms > 0 && ms < 200) {
+        auto until = Clock::now() + std::chrono::milliseconds(ms);
+        while (Clock::now() < until) {
+        }
+    }
+}
+static void Report(double tickMs) {
+    sTick.push_back(tickMs);
+    auto now = Clock::now();
+    double el = Ms(sLastReport, now) / 1000.0;
+    if (el < 10.0 || sTick.size() < 8) {
+        return;
+    }
+    for (auto* v : { &sWait, &sBusy, &sSleep, &sTick }) {
+        std::sort(v->begin(), v->end());
+    }
+    size_t n = sTick.size();
+    SPDLOG_INFO("SOH_PACE tick_ms p50={:.2f} p95={:.2f} max={:.2f} ticks={} tps={:.2f} frames={} "
+                "wait_ms p50={:.2f} p95={:.2f} max={:.2f} busy_ms p50={:.2f} p95={:.2f} max={:.2f} "
+                "sleep_ms p50={:.2f} p95={:.2f} skipped={} skip_ticks={} debt_avg={:.2f} debt_max={:.2f} "
+                "catchup={} stress={} thermal={} power={}",
+                Pct(sTick, 0.5), Pct(sTick, 0.95), sTick.back(), n, n / el, sBusy.size(), Pct(sWait, 0.5),
+                Pct(sWait, 0.95), sWait.empty() ? 0.0 : sWait.back(), Pct(sBusy, 0.5), Pct(sBusy, 0.95),
+                sBusy.empty() ? 0.0 : sBusy.back(), Pct(sSleep, 0.5), Pct(sSleep, 0.95), sSkipped, sSkipTicks,
+                sDebtSum / n, sDebtMax, CVarGetInteger("gSohIos.TickCatchup", 1),
+                CVarGetInteger("gSohIos.PaceStressMs", 0), SohIos_ThermalState(), SohIos_PowerState());
+    sWait.clear();
+    sBusy.clear();
+    sSleep.clear();
+    sTick.clear();
+    sSkipped = 0;
+    sSkipTicks = 0;
+    sDebtSum = 0.0;
+    sDebtMax = 0.0;
+    sLastReport = now;
+}
+} // namespace SohIosPace
+
+extern "C" void SohIos_PaceDrawableBegin(void) {
+    SohIosPace::sDrawBegin = SohIosPace::Clock::now();
+}
+extern "C" void SohIos_PaceDrawableEnd(void) {
+    SohIosPace::sDrawEnd = SohIosPace::Clock::now();
+    SohIosPace::sHaveDrawEnd = true;
+    SohIosPace::sWait.push_back(SohIosPace::Ms(SohIosPace::sDrawBegin, SohIosPace::sDrawEnd));
+}
+extern "C" void SohIos_PaceSleepBegin(void) {
+    SohIosPace::StressSpin();
+    SohIosPace::sSleepBegin = SohIosPace::Clock::now();
+    if (SohIosPace::sHaveDrawEnd) {
+        SohIosPace::sBusy.push_back(SohIosPace::Ms(SohIosPace::sDrawEnd, SohIosPace::sSleepBegin));
+        SohIosPace::sHaveDrawEnd = false;
+    }
+}
+extern "C" void SohIos_PaceSleepEnd(void) {
+    SohIosPace::sSleep.push_back(SohIosPace::Ms(SohIosPace::sSleepBegin, SohIosPace::Clock::now()));
+}
+#endif
+
