+#ifdef __IOS__
+// SOH_IOS_PERF (overlay 0008): frame/tick cadence probe. wall_ms is the
+// interval between consecutive presents; eng_ms is the time inside
+// DrawAndRunGraphicsCommands. BOTH include in-present blocking, so
+// wall~=eng means blocked-inside (GPU/pacing), wall>>eng means CPU outside.
+#include <algorithm>
+#include <chrono>
+// Thermal state provider lives in the app shell (SohIosShell.m).
+extern "C" int SohIos_ThermalState(void);
+// True GPU frame time, written by gfx_metal's completed handler (0028).
+extern "C" volatile float gSohIosGpuMs;
+extern "C" volatile uint64_t gSohIosUpWinBytes;
+extern "C" volatile int gSohIosUpWinCount;
+// Per-window shader compile ledgers (0035, reset on read).
+extern "C" void SohIos_LibWindowStats(float* ms, unsigned int* count);
+extern "C" void SohIos_PsoWindowStats(float* ms, unsigned int* count);
+namespace SohIosPerf {
+struct Probe {
+    std::vector<double> frameMs;
+    std::vector<double> engMs;
+    std::vector<double> gpuMs;
+    uint64_t ticks = 0;
+    uint32_t hudFrames = 0;
+    float hudFps = 0.0f;
+    std::chrono::steady_clock::time_point hudWindowStart = std::chrono::steady_clock::now();
+    // rev5 (VR R0, spec D10): a rolling 1 s SIM-TICK rate beside the 1 s
+    // fps, so the pacing triple (engine fps / tick tps / present rate) can be
+    // dumped on demand — the 10 s SOH_PERF line is far too coarse for a probe
+    // and the tick rate is the half-rate-bug detector.
+    uint32_t tickWindowCount = 0;
+    float hudTps = 0.0f;
+    std::chrono::steady_clock::time_point tickWindowStart = std::chrono::steady_clock::now();
+    std::chrono::steady_clock::time_point lastFrame{};
+    std::chrono::steady_clock::time_point lastReport = std::chrono::steady_clock::now();
+    void OnFrame(double engineMs) {
+        engMs.push_back(engineMs);
+        gpuMs.push_back((double)gSohIosGpuMs);
+        auto now = std::chrono::steady_clock::now();
+        hudFrames++;
+        double hudEl = std::chrono::duration<double>(now - hudWindowStart).count();
+        if (hudEl >= 1.0) {
+            hudFps = (float)(hudFrames / hudEl);
+            hudFrames = 0;
+            hudWindowStart = now;
+        }
+        if (lastFrame.time_since_epoch().count() != 0) {
+            frameMs.push_back(std::chrono::duration<double, std::milli>(now - lastFrame).count());
+        }
+        lastFrame = now;
+    }
+    void OnTick() {
+        ticks++;
+        auto now = std::chrono::steady_clock::now();
+        tickWindowCount++;
+        {
+            double tel = std::chrono::duration<double>(now - tickWindowStart).count();
+            if (tel >= 1.0) {
+                hudTps = (float)(tickWindowCount / tel);
+                tickWindowCount = 0;
+                tickWindowStart = now;
+            }
+        }
+        double el = std::chrono::duration<double>(now - lastReport).count();
+        if (el < 10.0 || frameMs.size() < 8 || engMs.size() < 8) {
+            return;
+        }
+        std::sort(frameMs.begin(), frameMs.end());
+        std::sort(engMs.begin(), engMs.end());
+        auto pct = [](std::vector<double>& v, double p) { return v[(size_t)(p * (v.size() - 1))]; };
+        std::sort(gpuMs.begin(), gpuMs.end());
+        float libMsW = 0, psoMsW = 0;
+        unsigned int libN = 0, psoN = 0;
+        SohIos_LibWindowStats(&libMsW, &libN);
+        SohIos_PsoWindowStats(&psoMsW, &psoN);
+        SPDLOG_INFO("SOH_PERF wall_ms p50={:.2f} p95={:.2f} p99={:.2f} max={:.2f} "
+                    "eng_ms p50={:.2f} p95={:.2f} max={:.2f} gpu_ms p50={:.2f} p95={:.2f} n={} fps={:.1f} "
+                    "sim_tps={:.2f} thermal={} up_mb={:.1f} up_n={} lib_ms={:.1f} lib_n={} pso_ms={:.1f} pso_n={}",
+                    pct(frameMs, 0.5), pct(frameMs, 0.95), pct(frameMs, 0.99), frameMs.back(),
+                    pct(engMs, 0.5), pct(engMs, 0.95), engMs.back(), pct(gpuMs, 0.5), pct(gpuMs, 0.95),
+                    frameMs.size(), frameMs.size() / el, ticks / el, SohIos_ThermalState(),
+                    gSohIosUpWinBytes / 1048576.0, gSohIosUpWinCount, libMsW, libN, psoMsW, psoN);
+        gSohIosUpWinBytes = 0;
+        gSohIosUpWinCount = 0;
+        frameMs.clear();
+        engMs.clear();
+        gpuMs.clear();
+        ticks = 0;
+        lastReport = now;
+    }
+};
+static Probe gPerfProbe;
+} // namespace SohIosPerf
+
+// Rolling 1-second fps for the shell's performance HUD.
+extern "C" void SohIos_HudStats(float* fps) {
+    *fps = SohIosPerf::gPerfProbe.hudFps;
+}
+
+// rev5: the pacing pair for the VR/3D diagnostics dump (spec D10). Rolling
+// 1 s windows; present rate is measured in the compositor loop and joined
+// there into the triple.
+extern "C" void SohIos_PacingStats(float* fps, float* tps) {
+    if (fps != nullptr) {
+        *fps = SohIosPerf::gPerfProbe.hudFps;
+    }
+    if (tps != nullptr) {
+        *tps = SohIosPerf::gPerfProbe.hudTps;
+    }
+}
+#endif
