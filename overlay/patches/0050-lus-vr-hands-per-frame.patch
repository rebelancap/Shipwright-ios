+#ifdef __IOS__
+/* SOH_IOS (overlay 0050, VR R5): HAND MATRIX REGISTRATION. Matrix_ToMtx is
+ * the single funnel every Mtx in the game passes through (Matrix_NewMtx
+ * calls it), so tagging around the hand limb's draw catches BOTH the limb's
+ * own matrix and the held item's, which PostLimbDraw allocates separately
+ * out of the graph pool. Overlay 0042 sets the tag; it is cleared on the
+ * next override call, which is exactly the span that wants covering. */
+extern volatile int gSohVRHandMtxTag; /* 0 = none, hand + 1 */
+extern void* volatile gSohVRHandMtxPtr[2][4];
+extern volatile int gSohVRHandMtxCount[2];
+
+static void SohVrRegisterHandMtx(Mtx* dest) {
+    s32 sohHand = gSohVRHandMtxTag - 1;
+    s32 sohN;
+
+    if ((sohHand < 0) || (sohHand > 1) || (dest == NULL)) {
+        return;
+    }
+    sohN = gSohVRHandMtxCount[sohHand];
+    if ((sohN < 0) || (sohN >= 4)) {
+        return;
+    }
+    gSohVRHandMtxPtr[sohHand][sohN] = (void*)dest;
+    /* Count published AFTER the pointer, so a reader that catches the write
+     * in progress catches a smaller table, never a garbage pointer. */
+    gSohVRHandMtxCount[sohHand] = sohN + 1;
 }
+#endif
 
 Mtx* Matrix_MtxFToMtx(MtxF* src, Mtx* dest) {
     FrameInterpolation_RecordMatrixMtxFToMtx(src, dest);
+#ifdef __IOS__
+    /* One of the two routes into an Mtx; Matrix_ToMtx below is the other.
+     * Both are registered, because the held item's matrix can come through
+     * either depending on how the actor draws it. */
+    if (gSohVRHandMtxTag != 0) {
+        SohVrRegisterHandMtx(dest);
+    }
+#endif
     guMtxF2L(src, dest);
     return dest;
 }
 
