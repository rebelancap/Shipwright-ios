     FrameInterpolation_RecordMatrixToMtx(dest, file, line);
+#ifdef __IOS__
+    if (gSohVRHandMtxTag != 0) {
+        SohVrRegisterHandMtx(dest);
+    }
+#endif
     guMtxF2L(Matrix_CheckFloats(sCurrentMatrix, file, line), dest);
