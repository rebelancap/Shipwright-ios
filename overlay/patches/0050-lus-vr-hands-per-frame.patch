--- a/libultraship/src/fast/interpreter.cpp
+++ b/libultraship/src/fast/interpreter.cpp
@@ -1429,11 +1429,166 @@
     Interpreter::TransposedMatrixMul(coeffs, light_dir,
                                      mRsp->modelview_matrix_stack[mRsp->modelview_matrix_stack_size - 1]);
     Interpreter::NormalizeVector(coeffs);
+}
+
+#ifdef __IOS__
+// SOH_IOS (overlay 0050, VR R5): HANDS AT HEADSET RATE. See the patch
+// header. The recorded matrices are built once per GAME TICK; these let
+// GfxSpMatrix re-seat the two hands -- and everything drawn on their
+// matrices, the held sword and shield included -- onto the live pose of
+// THIS pair, ahead of the interpolation replacement map.
+//
+// gSohVRPairSlot is also declared by overlay 0031 further down this file; a
+// repeated extern of the same type is legal and is preferable to anchoring
+// this patch on text another patch inserted. The block carries C linkage:
+// the shell defines these in Objective-C, and a C++-mangled declaration
+// inside namespace Fast compiles perfectly and then fails to link.
+extern "C" {
+extern volatile int gSohVRPairSlot;
+extern volatile int gSohVRHandLive;
+extern volatile float gSohVRHandMat[2][2][16];
+extern volatile int gSohVRHandValid[2];
+extern void* volatile gSohVRHandMtxPtr[2][4];
+extern volatile int gSohVRHandMtxCount[2];
+extern volatile float gSohVRHandRecMat[2][16];
+extern volatile int gSohVRHandRecValid[2];
+extern volatile int gSohVRHandLiveHits;
+extern volatile int gSohVRHandLiveSearch;
+extern volatile int gSohVRMode;
+extern volatile int gSohVRFpActive;
 }
 
+// Interpreter::MatrixMul is a private static member and these are free
+// functions, so this is its body, verbatim (interpreter.cpp:1535-1543).
+static void Soh3DMatMul(float res[4][4], const float a[4][4], const float b[4][4]) {
+    float tmp[4][4];
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 4; j++) {
+            tmp[i][j] = a[i][0] * b[0][j] + a[i][1] * b[1][j] + a[i][2] * b[2][j] + a[i][3] * b[3][j];
+        }
+    }
+    memcpy(res, tmp, sizeof(tmp));
+}
+
+// The delta that carries a matrix recorded against the TICK's hand pose onto
+// this compositor frame's hand pose: D = inverse(H_rec) * H_live, row-vector,
+// so (L * H_rec) * D == L * H_live for any local part L. That identity is why
+// the held item follows the hand with no extra work -- its matrix carries the
+// same H_rec on the right and a different L on the left.
+//
+// H is an affine transform with a rotation-and-uniform-scale basis, so the
+// inverse is the 3x3 adjugate over the determinant plus the transformed
+// translation. A zero determinant means the published matrix is garbage:
+// return false and the caller takes the ordinary path, which is exactly R4's
+// behaviour. Every failure here degrades to R4, never to a missing hand.
+static bool Soh3DHandDelta(int hand, float out[4][4]) {
+    if (gSohVRHandLive == 0 || hand < 0 || hand > 1 || gSohVRHandValid[hand] == 0 ||
+        gSohVRHandRecValid[hand] == 0) {
+        return false;
+    }
+    int slot = gSohVRPairSlot & 1;
+    float R[4][4];
+    float L[4][4];
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 4; j++) {
+            R[i][j] = gSohVRHandRecMat[hand][i * 4 + j];
+            L[i][j] = gSohVRHandMat[slot][hand][i * 4 + j];
+        }
+    }
+    float det = R[0][0] * (R[1][1] * R[2][2] - R[1][2] * R[2][1]) -
+                R[0][1] * (R[1][0] * R[2][2] - R[1][2] * R[2][0]) +
+                R[0][2] * (R[1][0] * R[2][1] - R[1][1] * R[2][0]);
+    if (det > -1e-12f && det < 1e-12f) {
+        return false;
+    }
+    float id = 1.0f / det;
+    float inv[4][4] = { { 0 } };
+    inv[0][0] = (R[1][1] * R[2][2] - R[1][2] * R[2][1]) * id;
+    inv[0][1] = (R[0][2] * R[2][1] - R[0][1] * R[2][2]) * id;
+    inv[0][2] = (R[0][1] * R[1][2] - R[0][2] * R[1][1]) * id;
+    inv[1][0] = (R[1][2] * R[2][0] - R[1][0] * R[2][2]) * id;
+    inv[1][1] = (R[0][0] * R[2][2] - R[0][2] * R[2][0]) * id;
+    inv[1][2] = (R[0][2] * R[1][0] - R[0][0] * R[1][2]) * id;
+    inv[2][0] = (R[1][0] * R[2][1] - R[1][1] * R[2][0]) * id;
+    inv[2][1] = (R[0][1] * R[2][0] - R[0][0] * R[2][1]) * id;
+    inv[2][2] = (R[0][0] * R[1][1] - R[0][1] * R[1][0]) * id;
+    // Row-vector: the translation ROW of the inverse is -t * inv3.
+    for (int j = 0; j < 3; j++) {
+        inv[3][j] = -(R[3][0] * inv[0][j] + R[3][1] * inv[1][j] + R[3][2] * inv[2][j]);
+    }
+    inv[3][3] = 1.0f;
+    Soh3DMatMul(out, inv, L);
+    return true;
+}
+
+// Fill `matrix` with the recorded matrix re-seated onto this pair's live hand
+// pose, or return false and leave it alone. Pointer identity, at most eight
+// compares, and outside VR the very first test fails.
+static bool Soh3DHandMatrix(const int32_t* addr, float matrix[4][4]) {
+    // rev2 (VR R6): SCOPED TO VR FIRST PERSON. The rev1 gate was
+    // gSohVRHandLive alone -- a knob that defaults to 1 and is never
+    // cleared -- so the pointer search below ran on every GfxSpMatrix in
+    // the flat window and the 3D panel too, where there are no hands and
+    // the table is meaningless. It is also the second half of the stale-
+    // pointer fix: the shell clears the table at both ends of a session,
+    // and outside a session this never looks at it at all.
+    if (gSohVRHandLive == 0 || gSohVRMode == 0 || gSohVRFpActive == 0) {
+        return false;
+    }
+    gSohVRHandLiveSearch = gSohVRHandLiveSearch + 1;
+    int hand = -1;
+    for (int h = 0; h < 2 && hand < 0; h++) {
+        int n = gSohVRHandMtxCount[h];
+        if (n > 4) {
+            n = 4;
+        }
+        for (int i = 0; i < n; i++) {
+            if (gSohVRHandMtxPtr[h][i] == (const void*)addr) {
+                hand = h;
+                break;
+            }
+        }
+    }
+    if (hand < 0) {
+        return false;
+    }
+    float d[4][4];
+    if (!Soh3DHandDelta(hand, d)) {
+        return false;
+    }
+    float rec[4][4];
+#ifndef GBI_FLOATS
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 4; j += 2) {
+            int32_t ip = addr[i * 2 + j / 2];
+            uint32_t fp = addr[8 + i * 2 + j / 2];
+            rec[i][j] = (int32_t)((ip & 0xffff0000) | (fp >> 16)) / 65536.0f;
+            rec[i][j + 1] = (int32_t)((ip << 16) | (fp & 0xffff)) / 65536.0f;
+        }
+    }
+#else
+    memcpy(rec, addr, sizeof(rec));
+#endif
+    Soh3DMatMul(matrix, rec, d);
+    gSohVRHandLiveHits = gSohVRHandLiveHits + 1;
+    return true;
+}
+#endif
+
 void Interpreter::GfxSpMatrix(uint8_t parameters, const int32_t* addr) {
     float matrix[4][4];
 
+#ifdef __IOS__
+    // SOH_IOS (overlay 0050, VR R5): ORDERED AHEAD OF THE INTERPOLATION MAP,
+    // deliberately. The interpolated value blends two GAME TICKS of hand
+    // pose, which is the 20 Hz stair-step this patch exists to remove; the
+    // recorded matrix plus THIS pair's live delta is the whole point. Both
+    // eyes of a pair read gSohVRPairSlot, which 0031 latches once for the
+    // pair, so the R2a one-pose-per-frame invariant holds.
+    if (Soh3DHandMatrix(addr, matrix)) {
+        // matrix is already filled; fall through to the stack work below.
+    } else
+#endif
     if (auto it = mCurMtxReplacements->find((Mtx*)addr); it != mCurMtxReplacements->end()) {
         for (int i = 0; i < 4; i++) {
             for (int j = 0; j < 4; j++) {
