+#ifdef __IOS__
+// iOS app shell hook (overlay 0012), implemented in app/ios/SohIosShell.m.
+extern "C" void SohIos_OnWindowCreated(struct SDL_Window*);
+#endif
 const SDL_Scancode lus_to_sdl_table[] = {
     SDL_SCANCODE_UNKNOWN,
     SDL_SCANCODE_ESCAPE,
@@ -391,6 +395,10 @@
     }
 
