+// SOH_IOS (overlay 0045): see the patch header. Nothing here runs off the game
+// thread -- a resource destructor can load other resources, and the memory
+// pressure source that asks for a trim only ever sets a flag.
+size_t ResourceManager::SohIosResourceCacheStats(size_t* outCount) {
+    const std::lock_guard<std::mutex> lock(mMutex);
+    size_t bytes = 0;
+    size_t count = 0;
+    for (const auto& entry : mResourceCache) {
+        if (!std::holds_alternative<std::shared_ptr<IResource>>(entry.second)) {
+            continue;
+        }
+        const auto& resource = std::get<std::shared_ptr<IResource>>(entry.second);
+        if (resource == nullptr) {
+            continue;
+        }
+        count++;
+        bytes += resource->GetPointerSize();
+    }
+    if (outCount != nullptr) {
+        *outCount = count;
+    }
+    return bytes;
 }
 
+size_t ResourceManager::SohIosTrimTextureResources(size_t* outEvicted) {
+    // 'OTEX' -- Fast::ResourceType::Texture, spelled as its FourCC so this
+    // translation unit does not have to depend on the Fast layer.
+    static const uint32_t kSohIosTextureType = 0x4F544558;
+    // Destroyed OUTSIDE the lock: a resource destructor can load other
+    // resources, and that would deadlock on the mutex we are holding. Upstream
+    // UnloadResource says exactly this in a comment and then keeps a variant it
+    // never assigns, which is the same bug written down.
+    std::vector<std::shared_ptr<IResource>> doomed;
+    size_t bytes = 0;
+    {
+        const std::lock_guard<std::mutex> lock(mMutex);
+        for (auto it = mResourceCache.begin(); it != mResourceCache.end();) {
+            if (!std::holds_alternative<std::shared_ptr<IResource>>(it->second)) {
+                ++it;
+                continue;
+            }
+            auto resource = std::get<std::shared_ptr<IResource>>(it->second);
+            if (resource == nullptr || resource->GetInitData() == nullptr) {
+                ++it;
+                continue;
+            }
+            if (resource->GetInitData()->Type != kSohIosTextureType) {
+                ++it;
+                continue;
+            }
+            // The cache holds one reference and `resource` above is the second.
+            // Anything higher means a live owner -- the RDP's loaded-texture
+            // metadata is the usual one -- and it is left alone.
+            if (resource.use_count() > 2) {
+                ++it;
+                continue;
+            }
+            bytes += resource->GetPointerSize();
+            doomed.push_back(resource);
+            it = mResourceCache.erase(it);
+        }
+    }
+    if (outEvicted != nullptr) {
+        *outEvicted = doomed.size();
+    }
+    doomed.clear();
+    return bytes;
+}
+
