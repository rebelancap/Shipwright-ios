+#ifdef __IOS__
+// SOH_IOS (overlay 0045): THE MEMORY GOVERNOR. See the patch header for why the
+// resource cache is the leak and why textures are the only class it is safe to
+// evict. Everything below runs on the GAME thread; the pressure source only
