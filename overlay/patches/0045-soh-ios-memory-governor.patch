+
+// Published for the shell's heartbeat and `vr mem`.
+extern "C" {
+volatile int gSohIosMemTrimReq = 0;      // set by the shell, cleared by the service
+volatile int gSohIosMemTrims = 0;        // trims performed
+volatile int gSohIosMemTrimFreedMB = 0;  // payload MB released by the last trim
+volatile int gSohIosMemTrimEvicted = 0;  // resources evicted by the last trim
+}
+
+extern "C" void SohIos_TexCacheStats(unsigned long long* outBytes, unsigned long long* outCount) {
+    unsigned long long bytes = 0;
+    unsigned long long count = 0;
+    auto instance = Fast::mInstance.lock();
+    if (instance != nullptr) {
+        if (instance->mRapi != nullptr) {
+            bytes = (unsigned long long)instance->mRapi->GetTextureBytes();
+        }
+        count = (unsigned long long)instance->mTextureCache.map.size();
+    }
+    if (outBytes != nullptr) {
+        *outBytes = bytes;
+    }
+    if (outCount != nullptr) {
+        *outCount = count;
+    }
+}
+
+// Upstream's TextureCacheClear parks every id on the free list and never calls
+// DeleteTexture, so it releases NO GPU memory -- which is why the existing
+// gfx_texture_cache_clear() having no callers was never the whole story.
+extern "C" void SohIos_TexCacheClearHard(void) {
+    auto instance = Fast::mInstance.lock();
+    if (instance == nullptr) {
+        return;
+    }
+    if (instance->mRapi != nullptr) {
+        for (const auto& entry : instance->mTextureCache.map) {
+            instance->mRapi->DeleteTexture(entry.second.texture_id);
+        }
+    }
+    instance->TextureCacheClear();
+}
+
+extern "C" void SohIos_ResCacheStats(unsigned long long* outBytes, unsigned long long* outCount) {
+    unsigned long long bytes = 0;
+    unsigned long long count = 0;
+    auto context = Ship::Context::GetRawInstance();
+    if (context != nullptr) {
+        auto rm = context->GetResourceManager();
+        if (rm != nullptr) {
+            size_t n = 0;
+            bytes = (unsigned long long)rm->SohIosResourceCacheStats(&n);
+            count = (unsigned long long)n;
+        }
+    }
+    if (outBytes != nullptr) {
+        *outBytes = bytes;
+    }
+    if (outCount != nullptr) {
+        *outCount = count;
+    }
+}
+
+// The trim itself. ALWAYS followed by the hard texture-cache clear: Fast3D keys
+// its cache on the texture's CPU ADDRESS, and freeing resources lets the
+// allocator hand that address to a different texture, which would alias onto a
+// live entry and draw the wrong image.
+extern "C" unsigned long long SohIos_MemoryTrim(void) {
+    auto context = Ship::Context::GetRawInstance();
+    if (context == nullptr) {
+        return 0;
+    }
+    auto rm = context->GetResourceManager();
+    if (rm == nullptr) {
+        return 0;
+    }
+    size_t evicted = 0;
+    size_t freed = rm->SohIosTrimTextureResources(&evicted);
+    SohIos_TexCacheClearHard();
+    gSohIosMemTrims = gSohIosMemTrims + 1;
+    gSohIosMemTrimFreedMB = (int)(freed / (1024 * 1024));
+    gSohIosMemTrimEvicted = (int)evicted;
+    SPDLOG_INFO("SOH_IOS memtrim: evicted {} texture resources, {} MB payload (trim #{})", evicted,
+                freed / (1024 * 1024), (int)gSohIosMemTrims);
+    return (unsigned long long)freed;
+}
+
+// Called from RunFrame (soh/src/code/graph.c) at the top of a game frame: no
+// display list built yet, no interpreter frame open, and the only thread that
+// is allowed to destroy a resource.
+extern "C" void SohIos_ServiceMemoryTrim(int sceneNum) {
+    static int sSohIosLastScene = -2;
+    static unsigned int sSohIosFrames = 0;
+    static unsigned int sSohIosNextCheck = 0;
+    static unsigned int sSohIosCooldownUntil = 0;
+
+    sSohIosFrames++;
+    bool sceneChanged = (sceneNum != sSohIosLastScene);
+    sSohIosLastScene = sceneNum;
+    bool requested = (gSohIosMemTrimReq != 0);
+
+    if (requested) {
+        gSohIosMemTrimReq = 0;
+        SohIos_MemoryTrim();
+        sSohIosCooldownUntil = sSohIosFrames + 900;
+        return;
+    }
+    // A SCENE CHANGE IS NOT ENOUGH, and the evidence says so plainly: Hyrule
+    // Field killed the app in 60-170 s WITHOUT leaving the scene. So the budget
+    // is also checked on a timer -- every 300 frames, about five seconds -- and
+    // the cheap frame is the one that does nothing at all.
+    if (!sceneChanged && sSohIosFrames < sSohIosNextCheck) {
+        return;
+    }
+    sSohIosNextCheck = sSohIosFrames + 300;
+    if (sSohIosFrames < sSohIosCooldownUntil) {
+        return; // a trim costs a full texture re-upload; do not thrash
+    }
+    auto context = Ship::Context::GetRawInstance();
+    if (context == nullptr) {
+        return;
+    }
+    int budgetMB = context->GetConsoleVariables()->GetInteger("gSohIos.ResCacheBudgetMB", 768);
+    if (budgetMB <= 0) {
+        return; // 0 disables the governor outright -- the A/B control
+    }
+    unsigned long long bytes = 0;
+    SohIos_ResCacheStats(&bytes, nullptr);
+    if (bytes <= (unsigned long long)budgetMB * 1024ull * 1024ull) {
+        return;
+    }
+    unsigned long long freed = SohIos_MemoryTrim();
+    // BACK OFF WHEN IT DID NOT HELP. If a trim over budget frees less than
+    // 32 MB, the cache is that big because it is all IN USE -- everything in it
+    // has a live owner -- and repeating the trim would buy nothing while paying
+    // a full texture re-upload every five seconds. Sixty seconds instead of
+    // five, and the pressure hook can still force one at any moment.
+    sSohIosCooldownUntil = sSohIosFrames + (freed < 32ull * 1024ull * 1024ull ? 3600 : 900);
+}
+#endif
