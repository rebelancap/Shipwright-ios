+             * gamepad-only (a Sense pair has no D-pad) and it is the gamepad's
+             * only way to reach the C items in VR. */
+            static u16 sohCFromSensePrev = 0;
+            u16 sohPressFromDpad = 0;
+            u16 sohRelFromDpad = 0;
+            float sohAxis;
+            /* (a) the turn level. (e) not while the ocarina is out. */
+            sohAxis = (float)sohRx / 85.0f;
+            if (sohAxis > 1.0f) {
+                sohAxis = 1.0f;
+            } else if (sohAxis < -1.0f) {
+                sohAxis = -1.0f;
+            }
+            /* rev8 (VR R8 part B): THE SAME OCARINA LATCH BUG overlay 0047 had.
+             * `msgCtx.ocarinaMode` holds OCARINA_MODE_04 from the moment the
+             * ocarina is put away until the next textbox opens, so rev3's test
+             * killed the VR smooth turn for the rest of the session after one
+             * ocarina use. msgMode 0x09..0x33 is every state that takes ocarina
+             * notes and nothing else, and it falls when the ocarina goes away. */
+            if ((gPlayState != NULL) &&
+                (gPlayState->msgCtx.msgMode >= MSGMODE_OCARINA_STARTING) &&
+                (gPlayState->msgCtx.msgMode <= MSGMODE_FROGS_WAITING)) {
+                sohAxis = 0.0f;
+            }
+            gSohVRTurnAxis = sohAxis;
+            /* rev7 (VR R7 verdict 9): the live scene, for the crash record and
+             * the heartbeat. It costs one store per tick and it is the
+             * difference between "the app died" and "the app died in Hyrule
+             * Field". -1 outside gameplay, which the shell prints as-is. */
+            {
+                extern volatile int gSohVRSceneNum;
+                gSohVRSceneNum = (gPlayState != NULL) ? (int)gPlayState->sceneNum : -1;
+            }
+            /* (b) clear only the C bits this stick deflection produced. */
+            if (sohRx > sohCThresh) {
+                sohCFromStick |= BTN_CRIGHT;
+            }
+            if (sohRx < -sohCThresh) {
+                sohCFromStick |= BTN_CLEFT;
+            }
+            if (sohRy > sohCThresh) {
+                sohCFromStick |= BTN_CUP;
+            }
+            if (sohRy < -sohCThresh) {
+                sohCFromStick |= BTN_CDOWN;
+            }
+            /* (d) the D-pad becomes the C-pad, edges and all. */
+            if (sohIn->cur.button & BTN_DUP) {
+                sohCFromDpad |= BTN_CUP;
+            }
+            if (sohIn->cur.button & BTN_DDOWN) {
+                sohCFromDpad |= BTN_CDOWN;
+            }
+            if (sohIn->cur.button & BTN_DLEFT) {
+                sohCFromDpad |= BTN_CLEFT;
+            }
+            if (sohIn->cur.button & BTN_DRIGHT) {
+                sohCFromDpad |= BTN_CRIGHT;
+            }
+            if (sohIn->press.button & BTN_DUP) {
+                sohPressFromDpad |= BTN_CUP;
+            }
+            if (sohIn->press.button & BTN_DDOWN) {
+                sohPressFromDpad |= BTN_CDOWN;
+            }
+            if (sohIn->press.button & BTN_DLEFT) {
+                sohPressFromDpad |= BTN_CLEFT;
+            }
+            if (sohIn->press.button & BTN_DRIGHT) {
+                sohPressFromDpad |= BTN_CRIGHT;
+            }
+            if (sohIn->rel.button & BTN_DUP) {
+                sohRelFromDpad |= BTN_CUP;
+            }
+            if (sohIn->rel.button & BTN_DDOWN) {
+                sohRelFromDpad |= BTN_CDOWN;
+            }
+            if (sohIn->rel.button & BTN_DLEFT) {
+                sohRelFromDpad |= BTN_CLEFT;
+            }
+            if (sohIn->rel.button & BTN_DRIGHT) {
+                sohRelFromDpad |= BTN_CRIGHT;
+            }
+            /* rev4 (VR R4): the RELEASE edge needs the PREVIOUS tick's set.
+             * sohCFromStick is this tick's deflection, so on the very tick the
+             * stick falls back under threshold it is already 0 -- and that is
+             * exactly the tick PadMgr_ProcessInputs raises `rel` for the C
+             * button the stick had been holding. rev3's rel mask was therefore
+             * a no-op, and a phantom "C released" edge with no matching press
+             * leaked to the game at the end of EVERY turn flick. Mask rel with
+             * the union of this tick's and last tick's stick-driven C set. */
+            {
+                static u16 sohCFromStickPrev = 0;
+                u16 sohCRelMask;
+                /* rev5 (VR R5): MASK BY PROVENANCE, not by bit. A bit the Sense
+                 * pair produced is never the stick's to clear, even when the
+                 * stick happens to be deflected the same way on the same tick.
+                 * The release edge needs the union of both ticks on BOTH sides:
+                 * the stick's previous set (rev4's fix for the phantom "C
+                 * released" at the end of every turn flick) and the Sense's
+                 * previous set (a Sense button released one tick before the
+                 * stick falls under threshold must still deliver its rel). */
+                sohCFromStick = (u16)(sohCFromStick & ~sohCFromSense);
+                sohCRelMask = (u16)((sohCFromStick | sohCFromStickPrev) &
+                                    ~(u16)(sohCFromSense | sohCFromSensePrev));
+                sohIn->cur.button = (u16)((sohIn->cur.button & ~sohCFromStick) | sohCFromDpad);
+                sohIn->press.button = (u16)((sohIn->press.button & ~sohCFromStick) | sohPressFromDpad);
+                sohIn->rel.button = (u16)((sohIn->rel.button & ~sohCRelMask) | sohRelFromDpad);
+                sohCFromStickPrev = sohCFromStick;
+                sohCFromSensePrev = sohCFromSense;
+            }
+            /* (c) the stick itself goes away: free-look and RightStickAim have
+             * nothing to do when the head IS the camera. */
+            sohIn->cur.right_stick_x = 0;
+            sohIn->cur.right_stick_y = 0;
+            sohIn->rel.right_stick_x = 0;
+            sohIn->rel.right_stick_y = 0;
+            sohIn->press.right_stick_x = 0;
+            sohIn->press.right_stick_y = 0;
+            /* Diagnostics for `vr room`: the pad the GAME will see this tick,
+             * and which C bits the stick had set. A right-stick flick that
+             * leaves pad_c_masked non-zero and pad_cur's C bits clear IS the
+             * regression-2 assertion, made in one line from the simulator. */
+            gSohVRPadCur = (int)sohIn->cur.button;
+            gSohVRPadCMasked = (int)sohCFromStick;
+        } else {
+            extern volatile float gSohVRTurnAxis;
+            extern volatile int gSohVRPadCMasked;
+            gSohVRTurnAxis = 0.0f;
+            gSohVRPadCMasked = 0;
+        }
+    }
+#endif
     GameState_Update(gameState);
 
